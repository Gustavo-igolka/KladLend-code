# =========================================================
# guide.sk — внутриигровой справочник.
# Открывается предметом "Справочник" (морское сердце) из лобби — см. lobbyitems.sk,
# а также командой /guide.
#
# Меню (GUI-сундук) — только навигация, без длинных текстов. Описание
# персонажа/раздела приходит игроку ЛИЧНЫМ сообщением в чат (меню при этом
# закрывается), так читать удобнее.
#
# Страницы меню: main, survivors, killers. Разделы в чат: round, gens, progress, stun, misc.
# Состояние: {guide.inv.%player%} = true, пока меню открыто, и
# {guide.page.%player%} = текущая страница. Чистится при закрытии меню,
# входе игрока и перезагрузке скрипта. Клики по инвентарям, пока открыт
# справочник, отменяются.
#
# ВАЖНО: цифры списаны с abilities.sk / round.sk / generators.sk. Если
# поменяешь кулдаун или число — обнови и текст здесь.
# В строках знак процента пишется как %% (иначе Skript принимает его за
# начало выражения). Здоровье — в сердцах.
# =========================================================

on load:
    loop all players:
        delete {guide.inv.%loop-player%}
        delete {guide.page.%loop-player%}

on join:
    delete {guide.inv.%player%}
    delete {guide.page.%player%}

command /guide:
    trigger:
        openGuideMenu(player)

# Меню открываем прямо в функции, где оно собрано (как в characters.sk), а флаг
# ставим ПОСЛЕ open: при смене страницы сервер сначала закрывает старое меню
# (close стирает флаг), потом открывает новое. Передача инвентаря параметром
# в другую функцию не работает — слоты терялись, меню открывалось пустым.

function guideHint(p: player):
    send "&7Открыть справочник снова: предмет «Справочник» или /guide." to {_p}

# ---------------------------------------------------------
# Меню
# ---------------------------------------------------------
function openGuideMenu(p: player):
    set {_inv} to a new chest inventory with 3 rows named "&b&lСправочник"
    set slot 10 of {_inv} to iron sword named "&a&lВыжившие" with lore "&7Выбери персонажа"
    set slot 12 of {_inv} to stone sword named "&c&lУбийцы" with lore "&7Выбери персонажа"
    set slot 14 of {_inv} to clock named "&e&lКак проходит раунд" with lore "&7Описание придёт в чат"
    set slot 16 of {_inv} to anvil named "&6&lГенераторы" with lore "&7Описание придёт в чат"
    set slot 20 of {_inv} to shield named "&9&lСтаны и ошеломление" with lore "&7Описание придёт в чат"
    set slot 22 of {_inv} to book named "&5&lПрогресс" with lore "&7Описание придёт в чат"
    set slot 24 of {_inv} to barrel named "&7&lУрон, шкафы и предметы" with lore "&7Описание придёт в чат"
    set {guide.inv.%{_p}%} to {_inv}
    set {guide.page.%{_p}%} to "main"
    open {_inv} to {_p}

function openGuideSurvivors(p: player):
    set {_inv} to a new chest inventory with 3 rows named "&a&lСправочник: Выжившие"
    set slot 9 of {_inv} to bow named "&aАндрей" with lore "&8Рашер"
    set slot 10 of {_inv} to clock named "&bРататуй" with lore "&8Рашер"
    set slot 11 of {_inv} to leather named "&aКирилл" with lore "&8Рашер"
    set slot 12 of {_inv} to iron sword named "&9Михуилонг" with lore "&8Страж"
    set slot 13 of {_inv} to wooden sword named "&fИлья" with lore "&8Страж"
    set slot 14 of {_inv} to golden sword named "&7Маёр" with lore "&8Страж"
    set slot 15 of {_inv} to iron nugget named "&2Саня" with lore "&8Поддержка"
    set slot 16 of {_inv} to sugar named "&dМякШмяка" with lore "&8Поддержка"
    set slot 17 of {_inv} to bow named "&bТомас" with lore "&8Поддержка"
    set slot 18 of {_inv} to crossbow named "&6Dartikil" with lore "&8Страж"
    set slot 22 of {_inv} to arrow named "&7Назад"
    set {guide.inv.%{_p}%} to {_inv}
    set {guide.page.%{_p}%} to "survivors"
    open {_inv} to {_p}

function openGuideKillers(p: player):
    set {_inv} to a new chest inventory with 3 rows named "&c&lСправочник: Убийцы"
    set slot 10 of {_inv} to stone sword named "&cДэнДэн"
    set slot 12 of {_inv} to bow named "&5Некромансик"
    set slot 14 of {_inv} to trident named "&cThe Anomaly"
    set slot 16 of {_inv} to iron axe named "&8The Project"
    set slot 20 of {_inv} to fermented spider eye named "&2Незрячий"
    set slot 18 of {_inv} to stone sword named "&cСамураи"
    set slot 22 of {_inv} to arrow named "&7Назад"
    set {guide.inv.%{_p}%} to {_inv}
    set {guide.page.%{_p}%} to "killers"
    open {_inv} to {_p}

# ---------------------------------------------------------
# Тексты (личные сообщения в чат)
# ---------------------------------------------------------
function guideSendChar(p: player, id: text):
    send " " to {_p}
    if {_id} is "andrey":
        send "&a&l— Андрей &8(Рашер, 10 сердец)" to {_p}
        send "&7Рашер: быстрый выживший без оружия. Три зелья — три способа уйти от убийцы." to {_p}
        send "&aЗелье скорости &7(КД 50 с): Speed I на 10 сек и снимает с тебя замедление." to {_p}
        send "&eЗелье стойкости &7(КД 50 с): на 10 сек урон по тебе не проходит совсем, но ты сильно замедлен (Slowness V). Хорошо, чтобы «пересидеть» погоню у генератора." to {_p}
        send "&fЗелье невидимости &7(КД 40 с): невидимость на 10 сек. Броня на это время тоже прячется." to {_p}
        send "&7Каждое зелье даёт немного злости и опыта." to {_p}
    else if {_id} is "hacker":
        send "&b&l— Рататуй &8(Рашер, 10 сердец)" to {_p}
        send "&bМетка телепорта &7(КД 1 с): запоминает точку, куда потом вернёшься. Расстояние до метки показано в экшнбаре. Метку, поставленную до старта раунда, сбрасывает." to {_p}
        send "&bТелепорт &7(КД 70 с): нужна метка. 6 сек каста, ты замедлен (Slowness III). Любой полученный урон прерывает телепорт, а кулдаун к этому моменту уже потрачен. После прибытия светишься 5 сек." to {_p}
        send "&bСила &7(КД 15 с): два случайных бафла на 4 сек. Основной: Скорость, Резист или Невидимость. Дополнительный: Прыгучесть, Регенерация, Ночное зрение или Медленное падение." to {_p}
    else if {_id} is "kirill":
        send "&a&l— Кирилл &8(Рашер, 10 сердец)" to {_p}
        send "&aВор &7(КД 25 с): рывок по направлению взгляда. Какой именно рывок — решает режим Глича и заряд:" to {_p}
        send "  &6Бампер &7(заряжен): при касании убийцы отбрасывает его." to {_p}
        send "  &bПризрак &7(заряжен): рывок короче, при касании даёт тебе Speed III на 5 сек." to {_p}
        send "  &eМанёвр &7(не требует заряда): 2 сек готовишься стоя, затем самый дальний рывок, после него ты на 3 сек замедлен (Slowness III)." to {_p}
        send "  &7Если режим не заряжен — обычный базовый рывок без эффектов." to {_p}
        send "&bГлич &7(КД 1 с): переключает режим по кругу Бампер → Призрак → Манёвр. Заряд Бампера и Призрака общий: после срабатывания любого из них он возвращается через 40 сек, переключение режима его не сбрасывает." to {_p}
        send "&cИмплант &7(КД 70 с, отсчёт с момента включения): каждую секунду лечит, тратя 2 ячейки. Нужно минимум 2 ячейки; останавливается, когда ячейки кончились, здоровье полное или тебя ударили." to {_p}
        send "&eЯчейки: &7старт раунда — 6 из 10. +1 за починку генератора и +1 за удачное касание убийцы заряженным Бампером или Призраком." to {_p}
        send "&7Пассивка «Железо»: любое лечение, кроме Импланта, блокируется (аптечка, зелья Михуилонга и МякШмяки на тебя не действуют)." to {_p}
    else if {_id} is "mihuilong":
        send "&9&l— Михуилонг &8(Страж, 10 сердец)" to {_p}
        send "&9Меч оглушения &7(КД 40 с): удар по убийце не наносит урона, а оглушает его (подробно — в разделе «Станы и ошеломление»). Длительность примерно 5 сек, уменьшается, если в раунде несколько стражей. После удара ты сам на 2 сек замедлен." to {_p}
        send "&aЗелье исцеления: два раза за раунд, каждое лечит тебя на 3 сердца." to {_p}
        send "&7Страж: единственная роль, которая может надёжно остановить убийцу на месте." to {_p}
    else if {_id} is "ilya":
        send "&f&l— Илья &8(Страж, 8 сердец)" to {_p}
        send "&fДеревянный клинок &7(КД 30 с): урона убийце не наносит, эффект зависит от того, откуда ты бьёшь:" to {_p}
        send "  &aУдар в спину &7(убийца смотрит от тебя): оглушение примерно 7 сек и +1 сердце тебе." to {_p}
        send "  &bУдар в лицо: только замедление на 5 сек и ошеломление на 4 сек, лечит на полсердца." to {_p}
        send "  &fС Краской: рывок вперёд и оглушение даже в лицо." to {_p}
        send "&fКраска &7(КД 60 с): невидимость и замедление на 5 сек. Пока действует — следующий удар клинком становится рывком со станом." to {_p}
        send "&aШкала возрождения: каждое оглушение даёт заряд, три заряда — шкала заряжена. Если шкала заряжена, а метка стоит — после смерти возродишься на метке (6 сердец, свечение 15 сек). Без метки — на точке выживших. Возрождение одноразовое." to {_p}
        send "&aВозрождение (предмет): ставит метку, один раз за раунд." to {_p}
        send "&6В финальной дуэли возрождения нет: накопленные заряды сразу превращаются в здоровье (за каждый заряд +2 сердца к максимуму и +2 сердца лечения)." to {_p}
    else if {_id} is "mayor":
        send "&7&l— Маёр &8(Страж, 11 сердец)" to {_p}
        send "&fПерри &7(КД 23 с): 3 сек ты парируешь (Resistance V и Slowness V). Парируется удар каменным мечом убийцы: урон не проходит." to {_p}
        send "  &aУспех: &7Удар сразу готов, на 2 сек активен Сверхудар, ты получаешь +2 сердца поглощения (Over Heal), плюс злость и опыт." to {_p}
        send "  &cПровал: &7ты замедлен на 3 сек (Slowness I)." to {_p}
        send "&6Пинок &7(КД 45 с): отбрасывает убийцу и ошеломляет на 4 сек." to {_p}
        send "&7Удар &7(КД 60 с): обычный — замедление на 3 сек, ошеломление на 3 сек и отброс. Сверхудар (после успешного Перри) — полный стан, примерно 4,5 сек, уменьшается, если в раунде несколько стражей." to {_p}
        send "&7Три способности — три разных предмета: Перри (бумага), Пинок (золотой меч), Удар (железный меч)." to {_p}
    else if {_id} is "sanya":
        send "&2&l— Саня &8(Поддержка, 9 сердец)" to {_p}
        send "&cТурель &7(КД 40 с): ставится 6 сек, всё это время ты стоишь и не можешь двигаться. Замедляет убийцу (Slowness II) в радиусе 10 блоков. Одна турель на игрока: новая заменяет старую." to {_p}
        send "&aРаздатчик &7(КД 40 с): ставится 6 сек так же. Лечит на 1 сердце раз в 5 сек всех выживших в радиусе 2 блоков, включая тебя." to {_p}
        send "&7Убийца ломает любую постройку одним ударом. После твоей смерти постройки пропадают. Если ты умер за время установки — постройка не появится." to {_p}
        send "&7Пассивка: после любого полученного урона на 6 сек получаешь Resistance II." to {_p}
    else if {_id} is "alexey":
        send "&d&l— МякШмяка &8(Поддержка, 8 сердец)" to {_p}
        send "&dЗелье исцеления &7(КД 60 с): лечит на 3 сердца тебя и всех в радиусе 4 блоков. Чем больше раненых союзников вылечил, тем больше злости и опыта." to {_p}
        send "&5Рывок &7(КД 40 с): Speed IV на 3 сек." to {_p}
        send "&7В боссбаре показывается ближайший союзник и расстояние до него." to {_p}
    else if {_id} is "thomas":
        send "&b&l— Томас &8(Поддержка, 9 сердец)" to {_p}
        send "&7Три способности-луча. Стрелы не нужны: ПКМ — мгновенный луч по игроку в прицеле (до 25 блоков). Баффы идут союзнику в прицеле, замедление — убийце. Промах не тратит перезарядку, на себя баффы не действуют." to {_p}
        send "&bЛук: Скорость &7(КД 25 с): союзник в прицеле получает Speed I и поглощение на 3 сек." to {_p}
        send "&bЛук: Замедление &7(КД 25 с): по убийце — замедление, свечение 5 сек и ошеломление на 4 сек (способности и удары недоступны)." to {_p}
        send "&bЛук: Стойкость &7(КД 35 с): при попадании союзник получает Resistance IV, а Томас — Slowness IV и блокировку движения. Нужно непрерывно держать цель в прямой видимости; эффект длится до 7 сек и немедленно прерывается при потере обзора, смерти/выходе цели или любом полученном Томасом уроне. Переключиться на другую цель нельзя. Перезарядка запускается при попадании и сохраняется при прерывании." to {_p}
        send "&7В боссбаре показано расстояние до убийцы." to {_p}
    else if {_id} is "dartikil":
        send "&6&l— Dartikil &8(Страж, 6–9 сердец случайно)" to {_p}
        send "&7Азартный страж. Пассивка «Заряды» (0–3): копишь Монетой, тратишь остальными способностями — каждая из них тратит все накопленные заряды." to {_p}
        send "&6Монета &7(КД 1 с): 50/50 — +1 заряд или медлительность. Каждая неудача поднимает её уровень (I, II...), таймер 10 сек обновляется. Любой полученный урон снимает медлительность." to {_p}
        send "&cПистолет &7(КД 40 с, от 1 заряда): 1,5 сек целишься стоя. Исход зависит от зарядов: 1 — 50%% выстрел / 25%% ничего / 25%% взрыв, 2 — 70/15/15, 3 — 90/5/5." to {_p}
        send "  &6Выстрел: &7луч до 25 блоков, оглушает убийцу — до 6 сек вплотную, чем дальше, тем меньше (минимум 1 сек)." to {_p}
        send "  &4Взрыв: &73 сердца урона тебе и выжившим в радиусе 4 блоков; убийце рядом — стан 10 сек. После взрыва пистолет сломан до Шляпы." to {_p}
        send "&eЗнак &7(КД 30 с, от 1 заряда): случайный максимум хп 6–12 сердец (+1 при 2 зарядах, +2 при 3). Текущее хп смещается на ту же разницу, но не ниже 1 сердца." to {_p}
        send "&8Шляпа &7(КД 70 с, только при 3 зарядах): снижает медлительность до I и чинит пистолет." to {_p}
    else if {_id} is "denden":
        send "&c&l— ДэнДэн &8(Убийца)" to {_p}
        send "&7Пассивка: Прыгучесть II. Убийцу нельзя ранить, но можно оглушить и ошеломить." to {_p}
        send "&cКрюк &7(КД 30 с): зацепляет выжившего в прицеле на дистанции до 20 блоков и тянет к тебе 5 сек. Промах тоже уходит на кулдаун." to {_p}
        send "&cВзрывная месть &7(КД 45 с): крипер рождается у тебя, живёт 20 сек и сам бежит на ближайшего выжившего. Подбежав ближе чем на 3 блока, наносит 4 урона и отбрасывает цель. Тебя не трогает." to {_p}
        send "&bЗелье скорости &7(КД 50 с): Speed II на 15 сек." to {_p}
        send "&7Удар мечом: КД 3 сек, это же основной урон. Подробно — в разделе «Урон, шкафы и предметы»." to {_p}
    else if {_id} is "necromancer":
        send "&5&l— Некромансик &8(Убийца)" to {_p}
        send "&5Зомби: 6 призывов за раунд (кожаный шлем). Зомби охотится на выживших, игроки не могут его бить, владельца он не трогает." to {_p}
        send "&5Магический лук &7(КД 20 с): мгновенный луч по ПКМ в тех, кого держишь в прицеле (до 25 блоков), замедляет Slowness II и подсвечивает на 5 сек." to {_p}
        send "&5Дыхание &7(КД 35 с): подсвечивает на 5 сек всех выживших в радиусе 10 блоков, ты сам на 2 сек замедлен. Эти 2 сек — ещё и защитное окно: если в него попал стан, он отражается и ты получаешь Speed II на 5 сек." to {_p}
    else if {_id} is "anomaly":
        send "&c&l— The Anomaly &8(Убийца, Сталкер)" to {_p}
        send "&cНе ожидал? &7(КД 40 с): мгновенный луч по ПКМ в выжившего в прицеле (до 15 блоков): урон 1 сердце, слепота и свечение на 2 сек. Промах тоже уходит на кулдаун. Нельзя использовать в тени." to {_p}
        send "&5Сталк &7(КД 60 с): невидимость и Speed III на 30 сек. Пока ты в тени — нельзя бить и использовать способности. Повторное ПКМ — выйти раньше (2 сек замедления). При входе в тень и при выходе из неё слепит всех выживших в радиусе 7 блоков на 3 сек." to {_p}
        send "&cКапкан &7(КД 40 с): до трёх капканов одновременно (четвёртый заменяет самый старый). Наступивший выживший получает 3 сердца урона и замедление на 4 сек, ты получаешь Speed I на 7 сек." to {_p}
    else if {_id} is "project":
        send "&8&l— The Project &8(Убийца)" to {_p}
        send "&7Пассивка: постоянное замедление. Пассивка «Заражение»: ПКМ по генератору заражает его (минус 30%% прогресса, до 3 одновременно)." to {_p}
        send "&4Челюсти &7(КД 40 с): 7 сек стоишь на месте, вперёд по взгляду по одной вылетают 15 челюстей (до 15 блоков, останавливаются у стены), каждая живёт 14 сек. На весь каст засчитывается только один удар — 3 сердца. Оглушение прерывает каст: уже вылетевшие челюсти остаются, новые не появляются. Повторный ПКМ по кости во время каста (не раньше чем через секунду) останавливает его досрочно: ты сразу снова можешь двигаться, кулдаун не сокращается." to {_p}
        send "&4Хакер раш &7(КД 50 с): 1,5 сек замираешь, затем рывок примерно на 10 блоков. По выжившему без стака — ставит стак (свечение 10 сек) и откат всего 2 сек. По выжившему со стаком — 3 сердца урона, стак снят, откат обычный, ты замедлен на 4 сек. Оглушение во время замирания срывает рывок." to {_p}
        send "&4Телепорт к генератору &7(КД 80 с): по ПКМ открывается список заражённых генераторов. Закрыл меню без выбора — способность не тратится. После выбора 4 сек каста, оглушение срывает телепорт, а кулдаун потрачен. После телепорта 3 сек иммунитет к станам (способности в это время недоступны) и стак рывка всем живым выжившим." to {_p}
    else if {_id} is "samurai":
        send "&c&l— Самураи &8(Убийца)" to {_p}
        send "&7Пассивка «Блаженный»: вместе с тобой появляется бессмертный зомби. Он самостоятельно охотится на выживших; его можно временно оглушить." to {_p}
        send "&cМетка &7(КД 30 с): выбери выжившего в прицеле. Он подсвечивается на 15 сек, а весь твой наносимый урон по нему увеличивается на 0,5." to {_p}
        send "&4Разрезание &7(КД 30 с): захват цели в радиусе 3 блоков на 6 сек. Вы оба обездвижены и не можете использовать способности; тебя нельзя оглушить. Затем цель получает 4 урона. Смерть или выход цели прерывает захват. Промах тоже расходует перезарядку." to {_p}
        send "&5Переключение: меняешься позициями с Блаженным. Во время 3-секундного переключения стоишь на месте; после обмена получаешь иммунитет к оглушению на 6 сек." to {_p}
    else if {_id} is "blind":
        send "&2&l— Незрячий &8(Убийца)" to {_p}
        send "&2Споры: удар мечом заражает выжившего. Стадия 1 (15 сек) — без эффектов, стадия 2 (10 сек) — слепота и свечение, стадия 3 (10 сек) — ещё и тошнота III уровня, затем споры сами проходят. Таймер нельзя сбросить или ускорить. Заражённый рядом (3 блока) с другим выжившим 5 сек заражает и его." to {_p}
        send "&2След: за тобой тянется споровой след длиной 4 блока — наступивший в него выживший получает отравление на 2 сек." to {_p}
        send "&2Споровая завеса &7(КД 50 с): зона 3 блока на 10 сек. Ты внутри — невидимость и Speed I. Выжившие внутри заражаются и замедляются (Slowness I)." to {_p}
        send "&cСлепая ярость &7(КД 40 с): Сила I на 3 сек, но ты слепнешь на те же 3 сек." to {_p}
        send "&aПрорастание &7(КД 90 с): снимает споры со всех заражённых в 25 блоках, но они получают урон (1/2/3 сердца по стадии) и Slowness II на 2/3/4 сек." to {_p}
    guideHint({_p})

function guideSendSection(p: player, id: text):
    send " " to {_p}
    if {_id} is "round":
        send "&e&l— Как проходит раунд" to {_p}
        send "&4Старт: &7убийцей становится игрок с наибольшей злостью среди выбравших роль (злость обнуляется). Показывается убийца и карта, 10 сек на подготовку и 5 сек отсчёта. До «РАУНД НАЧАЛСЯ» способностями пользоваться и бить нельзя." to {_p}
        send "&eРежим «Время»: &7общий таймер в боссбаре. Старт — 70 сек плюс 50 сек за каждого выжившего. Дошёл до нуля, а кто-то жив — побеждают выжившие." to {_p}
        send "&aПочинка генератора: &f−10 сек &7| &cУбийство выжившего: &f+40 сек &7| &eВыживший вышел из игры: &f+40 сек" to {_p}
        send "&7Если все выжившие мертвы раньше — побеждает убийца." to {_p}
        send "&cФинальная дуэль (ЛМС): &7когда остаётся один выживший, начинается дуэль на 2 мин 15 сек. Основной таймер встаёт на паузу, оба участника светятся 12 сек, играет музыка. Продержался до конца — победа выжившего, убийца добил — победа убийцы. Возрождений в дуэли нет." to {_p}
        send "&7Естественная регенерация здоровья отключена: лечиться можно только аптечкой и способностями." to {_p}
        send "&7Вышел убийца — раунд завершается." to {_p}
    else if {_id} is "gens":
        send "&6&l— Генераторы" to {_p}
        send "&6Починка: &7генератор — наковальня на карте. Кликай по ней правой кнопкой и стой рядом (в пределах 2 блоков): прогресс идёт сам, +4%% в секунду, виден в экшнбаре. Отошёл — починка прервалась, но прогресс остаётся. Починенный генератор превращается в колокол." to {_p}
        send "&eЗачем чинить: &7каждый генератор срезает 10 сек с общего таймера и даёт злость и опыт тому, кто довёл до 100%%." to {_p}
        send "&4Заражение (The Project): &7заражённый генератор сразу теряет 30%% прогресса и не может завершиться, пока заражён. Чтобы снять заражение, нужно поднять прогресс ещё на 25%% (неважно, кто чинил) или довести до 100%%. Снявший получает стак рывка, тошноту III уровня и замедление на 5 сек, а убийца — Speed I на 5 сек. Заражено может быть до 3 генераторов одновременно." to {_p}
    else if {_id} is "progress":
        send "&5&l— Прогресс" to {_p}
        send "&6Злость: &7растёт у выживших за действия — старт раунда, починка генератора, способности, победа. У кого злость выше всех среди выбравших роль — тот убийца. Список — предмет «Злоба». У убийц злость не растёт." to {_p}
        send "&5Уровни: &7у каждого персонажа свой уровень. Опыт даётся за способности, починку, убийства и победу. Смотреть — предмет «Уровни». На 25, 50, 75 и 100 уровне открывается скин персонажа." to {_p}
        send "&aДеньги: &7начисляются вместе с опытом (в 1,5 раза больше опыта). Баланс — предмет «Деньги», тратятся в магазине скинов." to {_p}
        send "&6Скины: &7«Магазин скинов» — купить скин персонажу, «Выбор скина» — надеть купленный или открытый уровнем." to {_p}
    else if {_id} is "stun":
        send "&9&l— Станы и ошеломление" to {_p}
        send "&9Оглушение (стан): &7убийца полностью замирает на всё время, получает Слабость, не может бить мечом и использовать способности. Если он в этот момент кастует способность Проекта (Челюсти, Хакер раш, Телепорт) — каст срывается." to {_p}
        send "&9Кто оглушает: &7Михуилонг (меч, КД 40 с), Илья (клинок со спины или с Краской, КД 30 с), Маёр (Сверхудар после парирования, КД 60 с). Всё — только убийцу." to {_p}
        send "&9Длительность: &7базовая — Михуилонг 5 сек, Илья 7 сек, Маёр 4,5 сек. На каждого дополнительного стража в раунде вычитается по 0,5 сек (минимум 1 сек). Чем больше стражей, тем короче каждый стан." to {_p}
        send "&bЩит от станов: &7когда стан закончился, убийца получает щит и светится. Длина щита — 4 сек плюс 2 сек за каждого живого стража. Пока щит активен, новые станы поглощаются и убийцу нельзя «залочить». Все видят сообщение о щите." to {_p}
        send "&5Что отменяет стан: &7щит от станов; «Дыхание» Некромансика (2 сек окна после включения: стан отражается и даёт убийце Speed II на 5 сек); телепорт Проекта (3 сек иммунитета после прибытия)." to {_p}
        send "&eОшеломление: &7мягче стана. Убийца двигается, но 3–4 сек не может бить и использовать способности. Источники: Илья (удар в лицо, 4 сек, ещё и замедление 5 сек), Маёр (Пинок 4 сек; обычный Удар 3 сек плюс замедление), Томас (Лук: Замедление, 4 сек плюс замедление и свечение)." to {_p}
        send "&7Замедление и ошеломление не обновляют щит от станов — он включается только после настоящего оглушения." to {_p}
    else if {_id} is "misc":
        send "&7&l— Урон, шкафы и предметы" to {_p}
        send "&cУрон: &7убийцу ранить нельзя вообще. Выжившие друг друга не бьют. Единственный урон — удар убийцы каменным мечом (КД 3 сек) и его способности. Удар сбрасывает Bloodlust. До старта раунда урона нет." to {_p}
        send "&6Bloodlust: &7пока хоть один выживший в 15 блоках от убийцы, у убийцы растёт таймер погони: 15 сек — Speed I, 30 сек — Speed II, 45 сек — Speed III. Все вышли за 15 блоков или убийца попал по цели — таймер сбрасывается. Вне погони убийца всегда со Speed I." to {_p}
        send "&aШкафы (бочки): &7ПКМ — спрятаться (невидимость), повторный ПКМ — выйти (Speed I на 2 сек). Сам вылезешь через 15 сек. Убийца кликает по бочке — вытаскивает прячущегося и наносит ему урон." to {_p}
        send "&bПредметы на карте: &7за раунд появляется 1 аптечка (лечит 6 сердец) и 2 предмета Скорость (Speed I на 10 сек). Лежат на точках карты. Убийца подобрать их не может." to {_p}
        send "&7Если выживший вышел из игры — раунд продолжается без него, убийце даётся +40 сек." to {_p}
    guideHint({_p})

# ---------------------------------------------------------
# Клики и закрытие — по образцу магазина скинов (skins.sk):
#  * меню запоминаем в {guide.inv.%p%} и сверяем через event-inventory;
#  * "clicked slot" — объект Slot, номер даёт "index of clicked slot";
#  * закрывать/открывать меню прямо внутри клика нельзя — сначала wait 1 tick.
# ---------------------------------------------------------
on inventory click:
    if {guide.inv.%player%} is set:
        # Пока справочник открыт, свой инвентарь тоже заморожен (иначе шифт-кликом
        # можно затащить предметы в меню).
        cancel event
        if event-inventory is {guide.inv.%player%}:
            set {_slot} to index of clicked slot
            set {_p} to player
            set {_page} to {guide.page.%{_p}%}
            if {_page} is "main":
                if {_slot} is 10:
                    wait 1 tick
                    openGuideSurvivors({_p})
                    stop
                if {_slot} is 12:
                    wait 1 tick
                    openGuideKillers({_p})
                    stop
                if {_slot} is 14:
                    wait 1 tick
                    close {_p}'s inventory
                    guideSendSection({_p}, "round")
                    stop
                if {_slot} is 16:
                    wait 1 tick
                    close {_p}'s inventory
                    guideSendSection({_p}, "gens")
                    stop
                if {_slot} is 22:
                    wait 1 tick
                    close {_p}'s inventory
                    guideSendSection({_p}, "progress")
                    stop
                if {_slot} is 20:
                    wait 1 tick
                    close {_p}'s inventory
                    guideSendSection({_p}, "stun")
                    stop
                if {_slot} is 24:
                    wait 1 tick
                    close {_p}'s inventory
                    guideSendSection({_p}, "misc")
                    stop
                stop
            if {_page} is "survivors":
                if {_slot} is 22:
                    wait 1 tick
                    openGuideMenu({_p})
                    stop
                set {_id} to ""
                if {_slot} is 9:
                    set {_id} to "andrey"
                else if {_slot} is 10:
                    set {_id} to "hacker"
                else if {_slot} is 11:
                    set {_id} to "kirill"
                else if {_slot} is 12:
                    set {_id} to "mihuilong"
                else if {_slot} is 13:
                    set {_id} to "ilya"
                else if {_slot} is 14:
                    set {_id} to "mayor"
                else if {_slot} is 15:
                    set {_id} to "sanya"
                else if {_slot} is 16:
                    set {_id} to "alexey"
                else if {_slot} is 17:
                    set {_id} to "thomas"
                else if {_slot} is 18:
                    set {_id} to "dartikil"
                if {_id} is "":
                    stop
                wait 1 tick
                close {_p}'s inventory
                guideSendChar({_p}, {_id})
                stop
            if {_page} is "killers":
                if {_slot} is 22:
                    wait 1 tick
                    openGuideMenu({_p})
                    stop
                set {_id} to ""
                if {_slot} is 10:
                    set {_id} to "denden"
                else if {_slot} is 12:
                    set {_id} to "necromancer"
                else if {_slot} is 14:
                    set {_id} to "anomaly"
                else if {_slot} is 16:
                    set {_id} to "project"
                else if {_slot} is 20:
                    set {_id} to "blind"
                else if {_slot} is 18:
                    set {_id} to "samurai"
                if {_id} is "":
                    stop
                wait 1 tick
                close {_p}'s inventory
                guideSendChar({_p}, {_id})
                stop

on inventory close:
    if {guide.inv.%player%} is set:
        if event-inventory is {guide.inv.%player%}:
            delete {guide.inv.%player%}
            delete {guide.page.%player%}