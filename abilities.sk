function isBehind(attacker: player, victim: player) :: boolean:
    set {_victimYaw} to yaw of location of {_victim}
    set {_dirVec} to vector from location of {_victim} to location of {_attacker}
    set {_dirYaw} to yaw of {_dirVec}
    set {_diff} to {_dirYaw} - {_victimYaw}
    while {_diff} > 180:
        subtract 360 from {_diff}
    while {_diff} < -180:
        add 360 to {_diff}
    if {_diff} < 0:
        set {_diff} to {_diff} * -1
    if {_diff} > 120:
        return true
    else:
        return false

