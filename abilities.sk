# --- Луч Магического лука: рисуем частицами (фиолетовая пыль) вдоль взгляда игрока.
#     Берём vanilla-координаты "^ ^ ^N" от глаз — так учитывается и yaw, и pitch. ---
function necroBeam(p: player, len: number):
    loop floor({_len}) times:
        execute console command "/execute as %{_p}% at @s anchored eyes run particle minecraft:dust{color:[0.6,0.1,0.9],scale:1} ^ ^ ^%loop-number% 0 0 0 0 2 force"

# Магический лук — мгновенный луч (как Крюк ДенДена: цель в прицеле, без стрелы).
# Попал в выжившего (или манекен-выжившего) в радиусе {@necroBowRange} блоков —
# Slowness II + подсветка на 3 сек. КД 20 сек тратится в любом случае (и при промахе).
on right click holding blaze rod:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&5Магический лук":
        if {char.%player%} is "necromancer":
            cancel event
            if tryCooldown(player, "necro_bow", 20) is true:
                set {_target} to player's target entity
                set {_hit} to false
                if {_target} is a player:
                    if isManiac({char.%{_target}%}) is false:
                        if distance between player and {_target} <= {@necroBowRange}:
                            set {_hit} to true
                else if {dummy.kind.%{_target}%} is "survivor":
                    if distance between player and {_target} <= {@necroBowRange}:
                        set {_hit} to true
                if {_hit} is true:
                    set {_len} to distance between player and {_target}
                    necroBeam(player, {_len})
                    apply slowness 2 to {_target} for 5 seconds
                    apply glowing to {_target} for 5 seconds
                    send "&5Магический луч попал: замедление и подсветка на 5 сек!" to player
                    if {_target} is a player:
                        awardXP(player, "necromancer", 30)
                    else:
                        send "&5[DUMMY] Магический луч попал: замедление 2 на 3 сек + подсветка 3 сек." to {dummy.owner}
                else:
                    necroBeam(player, {@necroBowRange})
                    send "&7Луч ушёл в пустоту." to player

