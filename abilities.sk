    if name of player's tool is "&bСила":
        if {char.%player%} is "hacker":
            if tryCooldown(player, "hacker_cheat", 15) is true:
                addAnger(player, 0.2)
                awardXP(player, "hacker", 6)
                # --- Основной эффект: Скорость / Резист / Невидимость ---
                set {_rollMain} to a random integer between 1 and 3
                if {_rollMain} is 1:
                    apply speed 1 to player for 4 seconds
                    send "&bБафф (основной): Скорость!" to player
                else if {_rollMain} is 2:
                    apply resistance 1 to player for 4 seconds
                    send "&bБафф (основной): Резист!" to player
                else:
                    apply invisibility to player for 4 seconds
                    send "&bБафф (основной): Невидимость!" to player
                # --- Дополнительный эффект: Прыгучесть / Регенерация / Ночное зрение / Медленное падение ---
                set {_rollExtra} to a random integer between 1 and 4
                if {_rollExtra} is 1:
                    apply jump boost 1 to player for 4 seconds
                    send "&bБафф (доп.): Прыгучесть!" to player
                else if {_rollExtra} is 2:
                    apply regeneration 1 to player for 4 seconds
                    send "&bБафф (доп.): Регенерация!" to player
                else if {_rollExtra} is 3:
                    apply night vision to player for 4 seconds
                    send "&bБафф (доп.): Ночное зрение!" to player
                else:
                    apply slow falling to player for 4 seconds
                    send "&bБафф (доп.): Медленное падение!" to player
                wait 15 seconds
                send "&a✔ Сила снова готова!" to player

# ---------------------------------------------------------
# ТОМАС — выживший, класс поддержки
# ---------------------------------------------------------

# Три способности — мгновенные лучи (как Магический лук Некромансика), стрел нет.
# Предметы остаются луками, но по ПКМ стреляет не стрела, а луч: цель в прицеле,
# дальность {@thomasBeamRange} блоков. Для луча используется увеличенный hitbox.
#   Лук: Скорость   (КД 25) — союзник: Speed I + поглощение на 3 сек
#   Лук: Замедление (КД 25) — убийца: замедление + свечение 5 сек + ошеломление 4 сек
#   Лук: Стойкость  (КД 35) — союзник: Resistance IV до 7 сек; Томас получает Slowness IV
#   и не может двигаться. Промах по Стойкости не тратит перезарядку.
# В Батл Рояле (event.sk) союзников нет: баф Скорости/Стойкости уходит самому Томасу,
# а луч Замедления бьёт любого другого игрока.

function thomasBeam(p: player, len: number):
    loop floor({_len}) times:
        execute console command "/execute as %{_p}% at @s anchored eyes run particle minecraft:dust{color:[0.2,0.8,1.0],scale:1} ^ ^ ^%loop-number% 0 0 0 0 2 force"

# Цель луча Томаса. Увеличенный ray size расширяет хитбоксы целей вокруг прицела.
function thomasTarget(p: player, kind: text) :: entity:
    delete {_found}
    set {_t} to target entity of {_p} with ray size 1
    if {_t} is a player:
        if {_t} is not {_p}:
            if distance between {_p} and {_t} <= {@thomasBeamRange}:
                if {_kind} is "ally":
                    if isManiac({char.%{_t}%}) is false:
                        set {_found} to {_t}
                else:
                    if isManiac({char.%{_t}%}) is true:
                        set {_found} to {_t}
                    else if {event.misha.br_active} is true:
                        set {_found} to {_t}
    else if {dummy.kind.%{_t}%} is set:
        if distance between {_p} and {_t} <= {@thomasBeamRange}:
            if {_kind} is "ally":
                if {dummy.kind.%{_t}%} is "survivor":
                    set {_found} to {_t}
            else:
                if {dummy.kind.%{_t}%} is "maniac":
                    set {_found} to {_t}
    return {_found}

function thomasEndResist(p: player):
    set {_target} to {thomas.resistTarget.%{_p}%}
    delete {thomas.resistActive.%{_p}%}
    delete {thomas.resistTarget.%{_p}%}
    delete {thomas.resistToken.%{_p}%}
    if {_p} is online:
        remove slowness from {_p}
    if {_target} is set:
        if {_target} is alive:
            remove resistance from {_target}

# Томас фиксируется на выбранной цели максимум на 7 секунд.
# Потеря прямой видимости, смерть/выход цели или любой полученный урон прерывают эффект.
function thomasResist(p: player, t: entity):
    set {_token} to now
    set {thomas.resistActive.%{_p}%} to true
    set {thomas.resistTarget.%{_p}%} to {_t}
    set {thomas.resistToken.%{_p}%} to {_token}
    apply slowness 4 to {_p} for 7 seconds
    apply resistance 4 to {_t} for 7 seconds
    send "&bТы закрепился на союзнике. Удерживай его в поле зрения 7 секунд!" to {_p}
    if {_t} is a player:
        send "&bТомас поддерживает тебя: Resistance IV на 7 секунд." to {_t}
    else:
        send "&b[DUMMY] Томас: Resistance IV на манекене на срок до 7 сек." to {_p}

    loop 140 times:
        wait 1 tick
        if {thomas.resistToken.%{_p}%} is not {_token}:
            stop loop
        if {_p} is not online:
            thomasEndResist({_p})
            stop loop
        if {_t} is a player:
            if {_t} is not online:
                thomasEndResist({_p})
                stop loop
        if {_t} is not alive:
            thomasEndResist({_p})
            if {_p} is online:
                send "&cСоюзник больше не может поддерживать связь. Способность прервана." to {_p}
            stop loop
        if {_p} has no direct line of sight to {_t}:
            thomasEndResist({_p})
            send "&cТы потерял союзника из виду. Способность прервана." to {_p}
            stop loop

    if {thomas.resistToken.%{_p}%} is {_token}:
        thomasEndResist({_p})
        send "&aПоддержка завершена." to {_p}

# Во время Стойкости Томас физически не может перемещаться.
on player move:
    if {thomas.resistActive.%player%} is true:
        cancel event

function thomasApply(p: player, t: entity, type: text):
    if {_t} is a player:
        addAnger({_p}, 0.5)
        awardXP({_p}, "thomas", 15)
        if {_type} is "speed":
            if {event.misha.br_active} is true:
                apply speed 1 to {_p} for 3 seconds
                apply absorption 1 to {_p} for 3 seconds
                send "&bБатл Рояль: баф уходит тебе — Скорость + Оверхил!" to {_p}
            else:
                apply speed 1 to {_t} for 3 seconds
                apply absorption 1 to {_t} for 3 seconds
                send "&bЛуч попал: союзник получил Скорость + Оверхил!" to {_p}
                send "&bПолучен баф: Скорость + Оверхил!" to {_t}
        else if {_type} is "slow":
            send "&bЛуч попал: замедление, подсветка и ошеломление!" to {_p}
            apply slowness 1 to {_t} for 5 seconds
            apply glowing to {_t} for 5 seconds
            staggerPlayer({_t}, 4 seconds)
    else if {dummy.kind.%{_t}%} is set:
        if {_type} is "speed":
            apply speed 1 to {_t} for 3 seconds
            apply absorption 1 to {_t} for 3 seconds
            send "&b[DUMMY] Томас: баф Скорость 1 + Оверхил на 3 сек." to {_p}
        else if {_type} is "slow":
            apply slowness 1 to {_t} for 5 seconds
            apply glowing to {_t} for 5 seconds
            send "&b[DUMMY] Томас: замедление 1 + подсветка 5 сек + ошеломление 4 сек." to {_p}
            dummyStatus({_t}, "&e[ОШЕЛОМЛЁН]", 4 seconds)

function thomasCast(p: player, type: text):
    if {_type} is "speed":
        set {_key} to "thomas_speed"
        set {_cd} to 25
        set {_kind} to "ally"
        set {_ready} to "&a✔ Лук скорости снова готов!"
    else if {_type} is "slow":
        set {_key} to "thomas_slow"
        set {_cd} to 25
        set {_kind} to "enemy"
        set {_ready} to "&a✔ Лук замедления снова готов!"
    else:
        set {_key} to "thomas_resist"
        set {_cd} to 35
        set {_kind} to "ally"
        set {_ready} to "&a✔ Лук стойкости снова готов!"

    if {_type} is "resist":
        # В Батл Рояле союзников нет: сохраняем личный баф, теперь Resistance IV.
        if {event.misha.br_active} is true:
            if tryCooldown({_p}, {_key}, {_cd}) is true:
                apply resistance 4 to {_p} for 7 seconds
                send "&bБатл Рояль: Стойкость IV на 7 секунд." to {_p}
                set {_wait} to {_cd} * 1 second
                wait {_wait}
                send colored {_ready} to {_p}
            stop
        # Если способность ещё на перезарядке, не выдаём ложное сообщение о промахе.
        if getCooldownRemaining({_p}, "thomas_resist") > 0:
            send "&cЕщё не восстановилось, подожди немного." to {_p}
            stop
        set {_target} to thomasTarget({_p}, "ally")
        if {_target} is set:
            if tryCooldown({_p}, {_key}, {_cd}) is true:
                thomasBeam({_p}, distance between {_p} and {_target})
                if {_target} is a player:
                    addAnger({_p}, 0.5)
                    awardXP({_p}, "thomas", 15)
                thomasResist({_p}, {_target})
        else:
            thomasBeam({_p}, {@thomasBeamRange})
            send "&7Луч ушёл в пустоту. Перезарядка не потрачена." to {_p}
        stop

    if tryCooldown({_p}, {_key}, {_cd}) is true:
        set {_target} to thomasTarget({_p}, {_kind})
        if {_target} is set:
            thomasBeam({_p}, distance between {_p} and {_target})
            thomasApply({_p}, {_target}, {_type})
        else:
            thomasBeam({_p}, {@thomasBeamRange})
            send "&7Луч ушёл в пустоту." to {_p}
        set {_wait} to {_cd} * 1 second
        wait {_wait}
        send colored {_ready} to {_p}

on right click holding bow:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if {char.%player%} is "thomas":
        cancel event
        if name of player's tool is "&bЛук: Скорость":
            thomasCast(player, "speed")
        else if name of player's tool is "&bЛук: Замедление":
            thomasCast(player, "slow")
        else if name of player's tool is "&bЛук: Стойкость":
            thomasCast(player, "resist")

# ---------------------------------------------------------
# DARTIKIL — выживший, класс «страж» (хп на старте 6–9 сердец, см. characters.sk)
#
# Пассивка «Заряды»: {dart.charges.%p%} от 0 до 3. Копятся Монетой, тратятся
# Пистолетом / Знаком / Шляпой (все три тратят ВСЕ заряды).
#   Монета  (КД 1)  — 50/50: +1 заряд или медлительность. Каждая неудача поднимает
#                     уровень (I, II...) до {@dartMaxSlow}, таймер 10 сек обновляется.
#                     Любой полученный урон снимает медлительность целиком.
#   Пистолет (КД 40, от 1 заряда) — 1,5 сек подготовки стоя, потом исход по зарядам:
#                     1: 50/25/25, 2: 70/15/15, 3: 90/5/5 (Выстрел/Ничего/Взрыв).
#                     Выстрел — луч как у Томаса, стан зависит от расстояния.
#                     Взрыв — урон себе и выжившим рядом, убийце рядом стан 10 сек;
#                     после него пистолет сломан до Шляпы.
#   Знак    (КД 30, от 1 заряда) — случайный максимум хп 6–12 сердец (+1 при 2 зарядах,
#                     +2 при 3); текущее хп смещается на ту же разницу, но не ниже 1 сердца.
#   Шляпа   (КД 70, только 3 заряда) — снижает медлительность до I и чинит пистолет.
# ---------------------------------------------------------

function dartCharges(p: player) :: number:
    if {dart.charges.%{_p}%} is not set:
        return 0
    return {dart.charges.%{_p}%}

# Стан Выстрела: 6 сек в упор, линейно падает до 1 сек на предельной дальности луча.
# Как и у остальных стражей, -0.5 сек за каждого лишнего стража в раунде (не меньше 1).
function dartStunSeconds(dist: number) :: number:
    set {_s} to 6 - (({_dist} / {@thomasBeamRange}) * 5)
    set {_guards} to 0
    loop all players:
        if {char.%loop-player%} is "mihuilong" or "ilya" or "mayor" or "dartikil":
            add 1 to {_guards}
    if {_guards} > 1:
        set {_s} to {_s} - (({_guards} - 1) * 0.5)
    if {_s} < 1:
        set {_s} to 1
    return {_s}

function dartBeam(p: player, len: number):
    loop floor({_len}) times:
        execute console command "/execute as %{_p}% at @s anchored eyes run particle minecraft:dust{color:[1.0,0.6,0.1],scale:1} ^ ^ ^%loop-number% 0 0 0 0 2 force"

function dartStunTarget(t: entity, secs: number):
    set {_d} to "%{_secs}% seconds" parsed as timespan
    if {_t} is a player:
        stunPlayer({_t}, {_d})
    else:
        dummyStatus({_t}, "&e[ОШЕЛОМЛЁН]", {_d})

# Медлительность Монеты: уровень задаётся только литералом (Skript не принимает
# переменную в «apply slowness N»), поэтому уровни 1–6 разобраны по веткам.
function dartApplySlow(p: player, lvl: number):
    remove slowness from {_p}
    if {_lvl} <= 1:
        apply slowness 1 to {_p} for 10 seconds
    else if {_lvl} is 2:
        apply slowness 2 to {_p} for 10 seconds
    else if {_lvl} is 3:
        apply slowness 3 to {_p} for 10 seconds
    else if {_lvl} is 4:
        apply slowness 4 to {_p} for 10 seconds
    else if {_lvl} is 5:
        apply slowness 5 to {_p} for 10 seconds
    else:
        apply slowness 6 to {_p} for 10 seconds

# --- Монета ---
on right click holding raw gold:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&6Монета":
        if {char.%player%} is "dartikil":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if dartCharges(player) >= 3:
                send "&eУже 3 заряда — монета не нужна." to player
                stop
            if tryCooldown(player, "dart_coin", 1) is true:
                set {_roll} to a random integer between 1 and 2
                if {_roll} is 1:
                    set {dart.charges.%player%} to dartCharges(player) + 1
                    send "&6Монета: &aудача! &e+1 заряд (%{dart.charges.%player%}%/3)" to player
                else:
                    set {_lvl} to 1
                    if {dart.slowLevel.%player%} is set:
                        set {_lvl} to {dart.slowLevel.%player%} + 1
                    if {_lvl} > {@dartMaxSlow}:
                        set {_lvl} to {@dartMaxSlow}
                    set {dart.slowLevel.%player%} to {_lvl}
                    remove slowness from player
                    dartApplySlow(player, {_lvl})
                    set {dart.slowToken.%player%} to now
                    set {_tok} to {dart.slowToken.%player%}
                    send "&6Монета: &cне повезло. &7Медлительность %{_lvl}% на 10 сек." to player
                    wait 10 seconds
                    if {dart.slowToken.%player%} is {_tok}:
                        delete {dart.slowLevel.%player%}
                        delete {dart.slowToken.%player%}

# Любой урон по Dartikil сразу снимает медлительность от Монеты.
on damage:
    if victim is a player:
        if {char.%victim%} is "dartikil":
            if {dart.slowLevel.%victim%} is set:
                delete {dart.slowLevel.%victim%}
                delete {dart.slowToken.%victim%}
                remove slowness from victim
                send "&eУдар сбил медлительность от Монеты!" to victim

# --- Пистолет ---
on right click holding crossbow:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&cПистолет":
        if {char.%player%} is "dartikil":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if {dart.pistolBroken.%player%} is true:
                send "&cПистолет сломан — починить его может только Шляпа." to player
                stop
            set {_n} to dartCharges(player)
            if {_n} < 1:
                send "&cДля Пистолета нужен хотя бы 1 заряд." to player
                stop
            if tryCooldown(player, "dart_pistol", 40) is true:
                set {_start} to now
                set {dart.charges.%player%} to 0
                send "&cПрицеливаешься... &7(зарядов потрачено: %{_n}%, стоишь 1,5 сек)" to player
                projectSlowWalk(player, 0, 1.5 seconds)
                if {stunned.%player%} is true:
                    send "&cВыстрел сорван оглушением!" to player
                else:
                    set {_shot} to 50
                    set {_none} to 25
                    if {_n} is 2:
                        set {_shot} to 70
                        set {_none} to 15
                    else if {_n} >= 3:
                        set {_shot} to 90
                        set {_none} to 5
                    set {_r} to a random integer between 1 and 100
                    if {_r} <= {_shot}:
                        # --- Выстрел ---
                        set {_t} to thomasTarget(player, "enemy")
                        if {_t} is set:
                            set {_dist} to distance between player and {_t}
                            dartBeam(player, {_dist})
                            set {_secs} to dartStunSeconds({_dist})
                            send "&6&lВыстрел! &7Стан на %round({_secs} * 10) / 10% сек (дистанция ~%round({_dist})% м.)." to player
                            awardXP(player, "dartikil", 20)
                            dartStunTarget({_t}, {_secs})
                        else:
                            dartBeam(player, {@thomasBeamRange})
                            send "&7Выстрел ушёл в пустоту." to player
                    else if {_r} <= {_shot} + {_none}:
                        # --- Ничего ---
                        send "&7Осечка. Заряды потрачены впустую." to player
                    else:
                        # --- Взрыв ---
                        set {_loc} to location of player
                        execute console command "/particle minecraft:explosion %x-coord of {_loc}% %y-coord of {_loc}% %z-coord of {_loc}% 0 0 0 0 1 force"
                        execute console command "/playsound minecraft:entity.generic.explode player @a %x-coord of {_loc}% %y-coord of {_loc}% %z-coord of {_loc}% 1"
                        set {dart.pistolBroken.%player%} to true
                        send "&4&lВзрыв! &cПистолет сломан — нужна Шляпа." to player
                        delete {_hit::*}
                        loop all players:
                            set {_o} to loop-player
                            if {_o} is not player:
                                if distance between {_o} and {_loc} <= {@dartBlastRadius}:
                                    if isManiac({char.%{_o}%}) is true:
                                        add {_o} to {_hit::*}
                                    else if {alive.%{_o}%} is true:
                                        damage {_o} by {@dartBlastDamage}
                                        send "&cТебя задел взрыв пистолета!" to {_o}
                        damage player by {@dartBlastDamage}
                        set {_dm} to dummyNearest({_loc}, "maniac", {@dartBlastRadius})
                        if {_dm} is set:
                            dummyStatus({_dm}, "&e[ОГЛУШЕН]", 10 seconds)
                        loop {_hit::*}:
                            send "&6Взрыв накрыл убийцу: стан на 10 сек!" to player
                            awardXP(player, "dartikil", 25)
                            stunPlayer(loop-value, 10 seconds)
                set {_left} to 40 seconds - (difference between {_start} and now)
                if {_left} > 0 seconds:
                    wait {_left}
                if {dart.pistolBroken.%player%} is true:
                    send "&7Откат Пистолета прошёл, но он сломан." to player
                else:
                    send "&a✔ Пистолет снова готов!" to player

# --- Знак ---
on right click holding oak sign:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&eЗнак":
        if {char.%player%} is "dartikil":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            set {_n} to dartCharges(player)
            if {_n} < 1:
                send "&cДля Знака нужен хотя бы 1 заряд." to player
                stop
            if tryCooldown(player, "dart_sign", 30) is true:
                set {dart.charges.%player%} to 0
                set {_old} to max health of player
                set {_new} to a random integer between 6 and 12
                if {_n} is 2:
                    add 1 to {_new}
                else if {_n} >= 3:
                    add 2 to {_new}
                set {_hp} to (health of player) + ({_new} - {_old})
                if {_hp} < 1:
                    set {_hp} to 1
                if {_hp} > {_new}:
                    set {_hp} to {_new}
                if {_new} < {_old}:
                    set health of player to {_hp}
                    set max health of player to {_new}
                else:
                    set max health of player to {_new}
                    wait 1 tick
                    set health of player to {_hp}
                send "&e&lЗнак! &7Максимум хп: %{_old}% → %{_new}% сердец (потрачено зарядов: %{_n}%)." to player
                wait 30 seconds
                send "&a✔ Знак снова готов!" to player

# --- Шляпа ---
on right click holding leather helmet:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&8Шляпа":
        if {char.%player%} is "dartikil":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if dartCharges(player) < 3:
                send "&cШляпе нужны все 3 заряда." to player
                stop
            if tryCooldown(player, "dart_hat", 70) is true:
                set {_start} to now
                set {dart.charges.%player%} to 0
                send "&8&lШляпа! &7Заряды потрачены." to player
                if {dart.pistolBroken.%player%} is true:
                    delete {dart.pistolBroken.%player%}
                    send "&aПистолет починен." to player
                if {dart.slowLevel.%player%} is set:
                    if {dart.slowLevel.%player%} > 1:
                        set {dart.slowLevel.%player%} to 1
                        remove slowness from player
                        dartApplySlow(player, 1)
                        set {dart.slowToken.%player%} to now
                        set {_tok} to {dart.slowToken.%player%}
                        send "&7Медлительность снижена до I." to player
                        wait 10 seconds
                        if {dart.slowToken.%player%} is {_tok}:
                            delete {dart.slowLevel.%player%}
                            delete {dart.slowToken.%player%}
                set {_left} to 70 seconds - (difference between {_start} and now)
                if {_left} > 0 seconds:
                    wait {_left}
                send "&a✔ Шляпа снова готова!" to player

# ---------------------------------------------------------
# THE ANOMALY (маньяк, класс "Сталкер")
# ---------------------------------------------------------

# --- Луч «Не ожидал?»: красная пыль вдоль взгляда (как necroBeam, но другой цвет). ---
function anomalyBeam(p: player, len: number):
    loop floor({_len}) times:
        execute console command "/execute as %{_p}% at @s anchored eyes run particle minecraft:dust{color:[0.9,0.05,0.05],scale:1} ^ ^ ^%loop-number% 0 0 0 0 2 force"

on right click holding stick:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&cНе ожидал?":
        if {char.%player%} is "anomaly":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if {anomaly.stalking.%player%} is true:
                send "&cТы в тени и не можешь использовать способности!" to player
                stop
            if tryCooldown(player, "anomaly_arrow", 40) is true:
                set {_target} to player's target entity
                set {_hit} to false
                if {_target} is a player:
                    if isManiac({char.%{_target}%}) is false:
                        if distance between player and {_target} <= {@anomalyBeamRange}:
                            set {_hit} to true
                else if {dummy.kind.%{_target}%} is "survivor":
                    if distance between player and {_target} <= {@anomalyBeamRange}:
                        set {_hit} to true
                if {_hit} is true:
                    anomalyBeam(player, distance between player and {_target})
                    apply glowing to {_target} for 2 seconds
                    send "&cЛуч попал: урон, слепота и свечение на 2 сек!" to player
                    if {_target} is a player:
                        apply blindness to {_target} for 2 seconds
                        damage {_target} by 2
                        awardXP(player, "anomaly", 30)
                    else:
                        send "&c[DUMMY] «Не ожидал?»: урон 2, слепота 2 сек, подсветка 2 сек." to {dummy.owner}
                else:
                    anomalyBeam(player, {@anomalyBeamRange})
                    send "&7Луч ушёл в пустоту." to player
                wait 40 seconds
                send "&a✔ Способность снова готова!" to player

# Защита до старта раунда: никаких выстрелов и урона, пока раунд не «живой».
on shoot:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop

on right click holding phantom membrane:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&5Сталк":
        if {char.%player%} is "anomaly":
            if {anomaly.stalking.%player%} is true:
                delete {anomaly.stalking.%player%}
                remove invisibility from player
                anomalyStalkBlind(player)
                apply slowness 5 to player for 2 seconds
                send "&5Выходишь из тени..." to player
                wait 2 seconds
                send "&a✔ Снова можешь атаковать и использовать способности!" to player
            else:
                if {stunned.%player%} is true:
                    send "&cТы оглушён и не можешь использовать способности!" to player
                    stop
                if {staggered.%player%} is true:
                    send "&eТы ошеломлён и не можешь использовать способности!" to player
                    stop
                if tryCooldown(player, "anomaly_stalk", 60) is true:
                    set {anomaly.stalking.%player%} to true
                    apply invisibility to player for 30 seconds
                    anomalyStalkBlind(player)
                    send "&5Ты растворился в тенях..." to player
                    wait 30 seconds
                    if {anomaly.stalking.%player%} is true:
                        delete {anomaly.stalking.%player%}
                        anomalyStalkBlind(player)
                        send "&a✔ Способность истекла, ты снова видим." to player
on right click holding tripwire hook:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&cКапкан":
        if {char.%player%} is "anomaly":
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if {anomaly.stalking.%player%} is true:
                send "&cТы в тени и не можешь использовать способности!" to player
                stop
            if tryCooldown(player, "anomaly_trap", 40) is true:
                if size of {anomaly.traps.%player%::*} >= 3:
                    set {_oldestIndex} to 999999
                    loop {anomaly.traps.%player%::*}:
                        if loop-index parsed as number < {_oldestIndex}:
                            set {_oldestIndex} to loop-index parsed as number
                    delete {anomaly.traps.%player%::%{_oldestIndex}%}
                add location of player to {anomaly.traps.%player%::*}
                send "&cКапкан установлен." to player
                wait 40 seconds
                send "&a✔ Капкан снова готов к установке!" to player

every 5 ticks:
    if {round.active} is true:
        if {round.maniac} is set:
            if {char.%{round.maniac}%} is "anomaly":
                loop {anomaly.traps.%{round.maniac}%::*}:
                    set {_trapIndex} to loop-index
                    set {_trapLoc} to loop-value
                    set {_triggered} to false
                    loop all players:
                        set {_s} to loop-player
                        if isManiac({char.%{_s}%}) is false:
                            if {alive.%{_s}%} is true:
                                if distance between {_s} and {_trapLoc} < anomalyTrapRadius():
                                    damage {_s} by 3
                                    apply slowness 4 to {_s} for 4 seconds
                                    maniacBoost({round.maniac}, 7, 1)
                                    send "&cКапкан сработал на %{_s}%!" to {round.maniac}
                                    send "&cТы попал в капкан!" to {_s}
                                    awardXP({round.maniac}, "anomaly", 30)
                                    set {_triggered} to true
                    if {_triggered} is true:
                        delete {anomaly.traps.%{round.maniac}%::%{_trapIndex}%}

# --- Радиус срабатывания капкана Аномалии (общий для игроков и манекена, dummy.sk) ---
function anomalyTrapRadius() :: number:
    return 1.8

# --- Лёгкий ориентир: тусклые красные частицы над каждым капканом ---
every 10 ticks:
    set {_o} to {round.maniac}
    if {round.active} is not true:
        set {_o} to {dummy.owner}
    if {_o} is set:
        loop {anomaly.traps.%{_o}%::*}:
            set {_l} to loop-value
            set {_y} to (y-coord of {_l}) + 0.1
            execute console command "/particle minecraft:dust{color:[0.9,0.05,0.05],scale:0.8} %x-coord of {_l}% %{_y}% %z-coord of {_l}% 0.6 0.02 0.6 0 3"

# ---------------------------------------------------------
# МАЁР (выживший, "страж")
# ---------------------------------------------------------

function grantMayorAbsorption(p: player):
    apply absorption 1 to {_p} for 999999 seconds
    send "&6&l✚ Over Heal обновлён: +2 сердца." to {_p}

on right click holding paper:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&fПерри":
        if {char.%player%} is "mayor":
            cancel event
            if tryCooldown(player, "mayor_perry", 23) is true:
                set {mayor.parrying.%player%} to true
                delete {mayor.parrySuccess.%player%}
                apply slowness 5 to player for 3 seconds
                apply resistance 5 to player for 3 seconds
                send "&fТы приготовился парировать..." to player
                wait 3 seconds
                delete {mayor.parrying.%player%}
                if {mayor.parrySuccess.%player%} is not true:
                    apply slowness 1 to player for 3 seconds
                    send "&cПарирование не удалось..." to player
                wait 20 seconds
                send "&a✔ Перри снова готово!" to player

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if victim is a player:
        if {char.%victim%} is "mayor":
            if {mayor.parrying.%victim%} is true:
                if attacker is a player:
                    set {_validParry} to false
                    if isManiac({char.%attacker%}) is true:
                        if attacker's tool is stone sword:
                            set {_validParry} to true
                    else if {event.misha.br_active} is true:
                        if attacker's tool is wooden sword:
                            set {_validParry} to true

                    if {_validParry} is true:
                        cancel event
                        set {mayor.parryBlocked.%victim%} to true
                        if {mayor.parrySuccess.%victim%} is not true:
                            set {mayor.parrySuccess.%victim%} to true
                            set {mayor.power.%victim%} to true
                            grantMayorAbsorption(victim)
                            delete {cd.mayor_strike.%victim%}
                            delete {cd.remaining::mayor_strike.%victim%}
                            delete {cdr::mayor_strike.%victim%}
                            addAnger(victim, 1)
                            awardXP(victim, "mayor", 30)
                            send "&a&lПарирование удалось! Удар мгновенно готов, Сверхудар активен 2 сек." to victim
                            wait 2 seconds
                            delete {mayor.power.%victim%}

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if attacker is a player:
        if victim is a player:
            if name of attacker's tool is "&6Пинок":
                if {char.%attacker%} is "mayor":
                    set {_kickAllowed} to false
                    if isManiac({char.%victim%}) is true:
                        set {_kickAllowed} to true
                    else if {event.misha.br_active} is true:
                        set {_kickAllowed} to true
                    if {_kickAllowed} is true:
                        cancel event
                        if tryCooldown(attacker, "mayor_kick", 45) is true:
                            push victim away from attacker with speed 3
                            staggerPlayer(victim, 4 seconds)
                            send "&6Пинок! Противник отброшен и ошеломлён." to attacker
                            addAnger(attacker, 1)
                            awardXP(attacker, "mayor", 30)
                            wait 45 seconds
                            send "&a✔ Пинок снова готов!" to attacker
                        else:
                            cancel event

on left click:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if {round.active} is true:
        if name of player's tool is "&6Пинок":
            if {char.%player%} is "mayor":
                tryCooldown(player, "mayor_kick", 45)

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if attacker is a player:
        if victim is a player:
            if name of attacker's tool is "&7Удар":
                if {char.%attacker%} is "mayor":
                    set {_strikeAllowed} to false
                    if isManiac({char.%victim%}) is true:
                        set {_strikeAllowed} to true
                    else if {event.misha.br_active} is true:
                        set {_strikeAllowed} to true
                    if {_strikeAllowed} is true:
                        cancel event
                        if tryCooldown(attacker, "mayor_strike", 60) is true:
                            if {mayor.power.%attacker%} is true:
                                stunPlayer(victim, getGuardStunDuration("mayor"))
                                push victim away from attacker with speed 3
                                send "&6&lСверхудар! Противник оглушён (стан)!" to attacker
                                addAnger(attacker, 1.5)
                                awardXP(attacker, "mayor", 45)
                                wait 60 seconds
                                send "&a✔ Удар снова готов!" to attacker
                            else:
                                apply slowness 1 to victim for 3 seconds
                                staggerPlayer(victim, 3 seconds)
                                push victim away from attacker with speed 1.2
                                send "&7Удар прошёл! Противник замедлен и ошеломлён." to attacker
                                addAnger(attacker, 1)
                                awardXP(attacker, "mayor", 30)
                                wait 60 seconds
                                send "&a✔ Удар снова готов!" to attacker
                        else:
                            cancel event

on left click:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if {round.active} is true:
        if name of player's tool is "&7Удар":
            if {char.%player%} is "mayor":
                tryCooldown(player, "mayor_strike", 60)

# ---------------------------------------------------------
# САНЯ (выживший, "поддержка") — 9 сердец.
# ---------------------------------------------------------

function destroySanyaStructures(p: player):
    if {sanya.turret.%{_p}%} is set:
        delete {sanyaOwner.%{sanya.turret.%{_p}%}%}
        delete {sanyaType.%{sanya.turret.%{_p}%}%}
        kill {sanya.turret.%{_p}%}
        delete {sanya.turret.%{_p}%}
    if {sanya.dispenser.%{_p}%} is set:
        delete {sanyaOwner.%{sanya.dispenser.%{_p}%}%}
        delete {sanyaType.%{sanya.dispenser.%{_p}%}%}
        kill {sanya.dispenser.%{_p}%}
        delete {sanya.dispenser.%{_p}%}

function sanyaTurretAura(p: player, stand: entity):
    while dbgLive() is true:
        if {sanya.turret.%{_p}%} is not {_stand}:
            stop loop
        loop all players:
            if {event.misha.br_active} is true:
                if loop-player is not {_p}:
                    if loop-player is within 10 blocks of {_stand}:
                        apply slowness 2 to loop-player for 2 seconds
            else if isManiac({char.%loop-player%}) is true:
                if loop-player is within 10 blocks of {_stand}:
                    apply slowness 2 to loop-player for 2 seconds
        loop {dummy.list::*}:
            if {dummy.kind.%loop-value%} is "maniac":
                if loop-value is within 10 blocks of {_stand}:
                    apply slowness 2 to loop-value for 2 seconds
        wait 1 second

function sanyaDispenserAura(p: player, stand: entity):
    while dbgLive() is true:
        if {sanya.dispenser.%{_p}%} is not {_stand}:
            stop loop
        # В БР лечит только владелицу — иначе лечила бы и противников,
        # раз тут нет команды "выжившие против маньяка", а все против всех
        if {event.misha.br_active} is true:
            if {alive.%{_p}%} is true:
                if {_p} is within 2 blocks of {_stand}:
                    heal {_p} by 1
        else:
            loop all players:
                if isManiac({char.%loop-player%}) is false:
                    if {alive.%loop-player%} is true:
                        if loop-player is within 2 blocks of {_stand}:
                            if {char.%loop-player%} is not "kirill":
                                heal loop-player by 1
        loop {dummy.list::*}:
            if {dummy.kind.%loop-value%} is "survivor":
                if loop-value is within 2 blocks of {_stand}:
                    send "&a[DUMMY] Раздатчик лечит манекен (+1 ХП каждые 5 сек)." to {dummy.owner}
        wait 5 seconds

on right click holding iron nugget:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&cТурель":
        if {char.%player%} is "sanya":
