on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if victim is an armor stand:
        if {sanyaOwner.%victim%} is set:
            if attacker is a player:
                set {_sanyaAllowed} to false
                if isManiac({char.%attacker%}) is true:
                    set {_sanyaAllowed} to true
                else if {event.misha.br_active} is true:
                    set {_sanyaAllowed} to true
                if {_sanyaAllowed} is true:
                    set {_owner} to {sanyaOwner.%victim%}
                    set {_type} to {sanyaType.%victim%}
                    if {_type} is "turret":
                        if {sanya.turret.%{_owner}%} is victim:
                            delete {sanya.turret.%{_owner}%}
                        send "&cВаша турель уничтожена!" to {_owner}
                    else if {_type} is "dispenser":
                        if {sanya.dispenser.%{_owner}%} is victim:
                            delete {sanya.dispenser.%{_owner}%}
                        send "&cВаш раздатчик уничтожен!" to {_owner}
                    delete {sanyaOwner.%victim%}
                    delete {sanyaType.%victim%}
                    kill victim
                else:
                    cancel event
            else:
                cancel event

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if victim is a player:
        if {char.%victim%} is "sanya":
            if {round.active} is true:
                if event isn't cancelled:
                    apply resistance 2 to victim for 6 seconds

# --- Стойки Сани (турель/раздатчик): нельзя снимать с них броню правым кликом.
#     Стойки без {sanyaOwner} (например, манекены) не затрагиваются. ---
on right click on armor stand:
    if {sanyaOwner.%clicked entity%} is set:
        cancel event
# ---------------------------------------------------------
# КИРИЛЛ (выживший, Рашер) — Вор / Глич / Имплант
# Шкала ячеек: {kirill.cells.%p%} (0-10, старт 6). Режим Глича:
# {kirill.mode.%p%} = "bumper" | "ghost" | "maneuver". Заряд спец-версии
# Бампера/Призрака (общий на оба): {kirill.modeCharged.%p%}.
#
# ВАЖНО: рывок реализован через толчок (push ... at speed X), а не через
# точную телепортацию — как и все остальные "рывки/отбросы" в этом файле
# (см. Дэндэна/Илью/Аномалию). Указанные в дизайне 5/10/3 блока — целевой
# ориентир для подбора скорости, а не гарантированная точная дистанция;
# рекомендую подстроить числа {_speed} ниже по факту тестов на сервере.
# ---------------------------------------------------------

# --- Заряжает 1 ячейку шкалы Кирилла (макс. 10). Вызывается из generators.sk
#     при починке гена и отсюда же при удачном столкновении в заряженном
#     Бампере/Призраке. Безопасно звать для не-Кирилла — просто ничего не делает. ---
function chargeKirillCell(p: player):
    if {char.%{_p}%} is "kirill":
        if {kirill.cells.%{_p}%} is not set:
            set {kirill.cells.%{_p}%} to 0
        if {kirill.cells.%{_p}%} < 10:
            add 1 to {kirill.cells.%{_p}%}
            send "&e+1 ячейка Импланта (%{kirill.cells.%{_p}%}%/10)" to {_p}

# --- Перезарядка спец-версии Бампера/Призрака: сбрасывает заряд, ждёт 40 сек,
#     возвращает. Общая на оба режима — переключение Гличем прогресс не сбрасывает. ---
function kirillStartModeRecharge(p: player):
    set {kirill.modeCharged.%{_p}%} to false
    wait 40 seconds
    if {char.%{_p}%} is "kirill":
        set {kirill.modeCharged.%{_p}%} to true
        send "&6Бампер/Призрак снова заряжены!" to {_p}

# --- Эффект попадания при рывке в конкретном разрешённом режиме ---
function kirillOnCollision(p: player, m: player, mode: text):
    if {_mode} is "bumper":
        push {_m} away from {_p} with speed 3.2
        send "&6Бампер! Убийца отброшен." to {_p}
        chargeKirillCell({_p})
        kirillStartModeRecharge({_p})
    else if {_mode} is "ghost":
        apply speed 3 to {_p} for 5 seconds
        send "&bПризрак! Получена скорость." to {_p}
        chargeKirillCell({_p})
        kirillStartModeRecharge({_p})
    else:
        send "&7Столкновение с убийцей." to {_p}

# --- Собственно рывок: толкает игрока и тикает, проверяя столкновение с
#     живым убийцей на протяжении полёта. resolvedMode уже посчитан заранее
#     в основном хендлере (base/bumper/ghost/maneuver). ---
function kirillTryDashCollision(p: player, resolvedMode: text) :: boolean:
    set {_nearest} to 9999
    delete {_maniac}
    loop all players:
        if isManiac({char.%loop-player%}) is true:
            if {alive.%loop-player%} is true:
                set {_d} to distance between {_p} and loop-player
                if {_d} < {_nearest}:
                    set {_nearest} to {_d}
                    set {_maniac} to loop-player
    delete {_dummyHit}
    set {_dm} to dummyNearest(location of {_p}, "maniac", {_nearest})
    if {_dm} is set:
        set {_dummyHit} to {_dm}
        set {_nearest} to distance between {_p} and {_dm}
    if {_nearest} < {@kirillHitRadius}:
        set {kirill.dashHit.%{_p}%} to true
        if {_dummyHit} is set:
            dummyKirillCollision({_p}, {_dummyHit}, {_resolvedMode})
        else if {_maniac} is set:
            kirillOnCollision({_p}, {_maniac}, {_resolvedMode})
        return true
    return false

# Проверка столкновения выполняется до импульса и после каждого тика движения:
# так контакт в упор не теряется из-за смещения игрока в первый тик.
function kirillPerformDash(p: player, resolvedMode: text):
    if {_resolvedMode} is "maneuver":
        set {_speed} to 1.7
        set {_steps} to 16
    else if {_resolvedMode} is "ghost":
        set {_speed} to 0.65
        set {_steps} to 8
    else:
        set {_speed} to 0.95
        set {_steps} to 10

    set {kirill.dashHit.%{_p}%} to false
    if kirillTryDashCollision({_p}, {_resolvedMode}) is true:
        stop
    push {_p} in direction of {_p} at speed {_speed}

    loop {_steps} times:
        wait 1 tick
        if {char.%{_p}%} is not "kirill":
            stop loop
        if {kirill.dashHit.%{_p}%} is true:
            stop loop
        if kirillTryDashCollision({_p}, {_resolvedMode}) is true:
            stop loop

    if {_resolvedMode} is "maneuver":
        apply slowness 3 to {_p} for 3 seconds

# --- Вор: рывок в сторону взгляда, кулдаун 25 сек. Режим/заряд решают,
#     какая версия рывка реально сработает. ---
on right click holding leather:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&aВор":
        if {char.%player%} is "kirill":
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if tryCooldown(player, "kirill_dash", 25) is true:
                set {_mode} to {kirill.mode.%player%}
                if {_mode} is "maneuver":
                    send "&eПодготовка к рывку..." to player
                    apply slowness 250 to player for 2 seconds
                    wait 2 seconds
                    # За 2 секунды раунд мог закончиться / Кирилла могли убить или оглушить
                    if dbgLive() is not true:
                        stop
                    if dbgAlive(player) is not true:
                        stop
                    if {stunned.%player%} is true:
                        stop
                    send "&aИспользовано: Вор (Маневренность)" to player
                    kirillPerformDash(player, "maneuver")
                else:
                    if {kirill.modeCharged.%player%} is true:
                        send "&aИспользовано: Вор (%{_mode}%, заряжено)" to player
                        kirillPerformDash(player, {_mode})
                    else:
                        send "&aИспользовано: Вор (базовый рывок)" to player
                        kirillPerformDash(player, "base")
                wait 25 seconds
                send "&a✔ Вор снова готов!" to player

# --- Глич: переключение режима первой способности, кулдаун 1 сек. ---
on right click holding prismarine shard:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&bГлич":
        if {char.%player%} is "kirill":
            if tryCooldown(player, "kirill_glitch", 1) is true:
                if {kirill.mode.%player%} is "bumper":
                    set {kirill.mode.%player%} to "ghost"
                    send "&bРежим Глича: Призрак" to player
                else if {kirill.mode.%player%} is "ghost":
                    set {kirill.mode.%player%} to "maneuver"
                    send "&bРежим Глича: Маневренность" to player
                else:
                    set {kirill.mode.%player%} to "bumper"
                    send "&bРежим Глича: Бампер" to player

# --- Имплант: хилит 1 сердце в секунду, тратя по 2 ячейки за тик, пока не
#     кончатся ячейки/хп не полное/не прервётся уроном. Кулдаун 70 сек с
#     момента активации. Пассивка "Железо" (ниже, on heal) блокирует любой
#     другой хил, пока этот тик не помечен как {kirill.implantHealing.%p%}. ---
on right click holding netherite scrap:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&cИмплант":
        if {char.%player%} is "kirill":
            if {kirill.cells.%player%} is not set:
                set {kirill.cells.%player%} to 0
            if {kirill.cells.%player%} < 2:
                send "&cНедостаточно ячеек для Импланта (нужно минимум 2)!" to player
                stop
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            # Без этой проверки при полном здоровье Имплант сразу выключался,
            # но кулдаун в 70 сек всё равно тратился
            if health of player >= max health of player:
                send "&7Здоровье уже полное — Имплант не нужен." to player
                stop
            if tryCooldown(player, "kirill_implant", 70) is true:
                set {kirill.implantActive.%player%} to true
                send "&cИмплант активирован!" to player
                set {_elapsedImplant} to 0 seconds
                while {kirill.implantActive.%player%} is true:
                    if {kirill.cells.%player%} < 2:
                        stop loop
                    if health of player >= max health of player:
                        stop loop
                    remove 2 from {kirill.cells.%player%}
                    set {kirill.implantHealing.%player%} to true
                    heal player by 2
                    delete {kirill.implantHealing.%player%}
                    set {_elapsedImplant} to {_elapsedImplant} + 1 second
                    wait 1 second
                delete {kirill.implantActive.%player%}
                send "&7Имплант завершил работу." to player
                set {_remaining} to 70 seconds - {_elapsedImplant}
                if {_remaining} > 0 seconds:
                    wait {_remaining}
                send "&a✔ Имплант снова готов!" to player

# --- Прерывание Импланта уроном ---
on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if {round.active} is true:
        if victim is a player:
            if {char.%victim%} is "kirill":
                if {kirill.implantActive.%victim%} is true:
                    delete {kirill.implantActive.%victim%}
                    send "&cИмплант прерван уроном!" to victim

# --- Пассивка "Железо": блокирует абсолютно любой хил, кроме тика Импланта ---
on heal:
    if {round.active} is true:
        if event-entity is a player:
            if {char.%event-entity%} is "kirill":
                if {kirill.implantHealing.%event-entity%} is not true:
                    cancel event

# ---------------------------------------------------------
# THE PROJECT (маньяк)
#
# Общие заметки по реализации (согласовано с автором):
#  - {project.channeling.%p%} — общий флаг "идёт channel". Ставится в начале
#    Челюстей/Хакер раша/Телепорта и снимается либо по завершении, либо
#    stunPlayer()-ом при внешнем стане (см. правку stunPlayer выше) — так
#    все три способности одинаково прерываются оглушением на этапе каста.
#  - Стак рывка ({project.dashStack.%survivor%}) — общий для Хакер раша,
#    Телепорта (успех навешивает всем) и Заражения (исцеление навешивает
#    вылечившему) — единая функция projectSetDashStack().
#  - Числа хитбоксов/скорости рывка — ориентир (аналог рывка Кирилла),
#    точную дистанцию/радиус нужно будет подстроить по тестам на сервере.
# ---------------------------------------------------------

# --- Стак рывка: 10 сек, подсвечивает выжившего (glowing) на то же время.
#     Токен нужен, чтобы повторная простановка стака не давала старому
#     таймеру погасить свежий стак раньше времени. ---
function projectSetDashStack(target: player):
    set {project.dashStack.%{_target}%} to true
    apply glowing to {_target} for 10 seconds
    set {project.dashStackToken.%{_target}%} to now
    set {_myToken} to {project.dashStackToken.%{_target}%}
    wait 10 seconds
    if {project.dashStackToken.%{_target}%} is {_myToken}:
        set {project.dashStack.%{_target}%} to false

# --- Замедление/заморозка игрока (Проект, стан любого игрока) через walk speed (а не эффект зелья): эффекты
#     пересекались с вечным slowness 1 и могли не сниматься. Токен защищает
#     от гонки (последний вызов выигрывает), по окончании скорость = 0.2.
#     speed 0 = стоит на месте. БЛОКИРУЕТ вызывающий триггер на время d. ---
function projectSlowWalk(p: player, speed: number, d: timespan):
    set {project.freezeToken.%{_p}%} to now
    set {_t} to {project.freezeToken.%{_p}%}
    set walk speed of {_p} to {_speed}
    wait {_d}
    if {project.freezeToken.%{_p}%} is {_t}:
        delete {project.freezeToken.%{_p}%}
        set walk speed of {_p} to 0.2

# ===========================================================
# Способность 1 — Челюсти (bone, КД 40 сек)
#
# Убийца полностью стоит все 7 секунд каста. Раз в ~9 тиков (7 сек / 15 ≈
# 0.47 сек, округлено) вылетает одна из 15 "челюстей" (визуал —
# evoker fangs): каждая новая появляется на расстоянии, равном своему
# номеру (1..15 блоков) от убийцы, строго по ГОРИЗОНТАЛЬНОМУ направлению
# взгляда В МОМЕНТ СВОЕГО спавна (pitch игнорируется, Y всегда = Y убийцы,
# уже вылетевшие челюсти направление не меняют). Если на пути в эту сторону
# стоит непроходимый блок (подъём рельефа) — дальнейшие челюсти в этом
# каста не появляются. Каждая челюсть "живёт" 14 секунд как зона поражения
# (see "every 1 second" ниже) — но на весь каст засчитывается только ОДИН
# удар суммарно по всем 15 челюстям и всем 14 сек их жизни.
# ===========================================================
function projectPerformJaws(p: player):
    set {project.channeling.%{_p}%} to true
    set {project.jawHitDone} to false
    loop 15 times:
        if {project.channeling.%{_p}%} is not true:
            stop loop
        if {char.%{_p}%} is not "project":
            stop loop
        set {_i} to loop-number
        set {_base} to location of {_p}
        set {_yaw} to yaw of {_base}
        set {_dx} to sin({_yaw}) * -1
        set {_dz} to cos({_yaw})
        set {_target} to location((x-coord of {_base}) + ({_dx} * {_i}), y-coord of {_base}, (z-coord of {_base}) + ({_dz} * {_i}), {_base}'s world)
        if block at {_target} is not passable:
            stop loop
        spawn an evoker fangs at {_target}
        add {_target} to {project.jawPoints::*}
        set {project.jawBorn.%{_target}%} to now
        wait 9 ticks
    delete {project.channeling.%{_p}%}

on right click holding bone:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&4Челюсти":
        if {char.%player%} is "project":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            # --- Досрочная остановка каста повторным ПКМ: движение возвращается сразу,
            #     новые челюсти не появляются, КД не сокращается. Первую секунду каста
            #     повторный клик игнорируется (защита от случайного двойного клика). ---
            if {project.jawsActive.%player%} is true:
                if {project.channeling.%player%} is true:
                    if difference between {project.jawStart.%player%} and now > 1 second:
                        delete {project.channeling.%player%}
                        delete {project.freezeToken.%player%}
                        delete {project.jawsActive.%player%}
                        set walk speed of player to 0.2
                        send "&4Челюсти остановлены досрочно." to player
                    stop
            if tryCooldown(player, "project_jaws", 40) is true:
                send "&4&lЧелюсти!" to player
                # --- Заморозка через walk speed (а не slowness 250): эффект зелья
                #     пересекался с вечным slowness 1 и мог не сниматься. Токен
                #     защищает от гонки, а скорость возвращается явно. ---
                set {project.freezeToken.%player%} to now
                set {_token} to {project.freezeToken.%player%}
                set {_start} to now
                set {project.jawStart.%player%} to now
                set {project.jawsActive.%player%} to true
                set walk speed of player to 0
                projectPerformJaws(player)
                set {_left} to 7 seconds - (difference between {_start} and now)
                if {_left} > 0 seconds:
                    wait {_left}
                delete {project.jawsActive.%player%}
                if {project.freezeToken.%player%} is {_token}:
                    delete {project.freezeToken.%player%}
                    set walk speed of player to 0.2
                wait 33 seconds
                send "&a✔ Челюсти снова готовы!" to player

# --- Страховка: если Проект не в заморозке Челюстей, а скорость не 0.2 —
#     возвращаем. Лечит зависание, даже если что-то пошло не так. ---
every 1 second:
    loop all players:
        if {char.%loop-player%} is set:
            if {project.freezeToken.%loop-player%} is not set:
                if walk speed of loop-player is not 0.2:
                    set walk speed of loop-player to 0.2

# --- Проверка попаданий по точкам-челюстям: каждую точку проверяем раз в
#     секунду в течение 14 сек её жизни; как только КТО-ТО из выживших в
#     ней окажется — засчитывается ЕДИНСТВЕННЫЙ удар на весь текущий каст
#     (флаг {project.jawHitDone}), дальнейшие точки перестают наносить урон
#     до следующего каста Челюстей. ---
every 1 second:
    if {round.active} is true:
        loop {project.jawPoints::*}:
            set {_loc} to loop-value
            if {project.jawBorn.%{_loc}%} is not set:
                remove {_loc} from {project.jawPoints::*}
            else if difference between {project.jawBorn.%{_loc}%} and now > 14 seconds:
                delete {project.jawBorn.%{_loc}%}
                remove {_loc} from {project.jawPoints::*}
            else if {project.jawHitDone} is not true:
                loop all players:
                    set {_s} to loop-player
                    if isManiac({char.%{_s}%}) is false:
                        if {alive.%{_s}%} is true:
                            if {_s} is within 1.3 blocks of {_loc}:
                                damage {_s} by 3
                                set {project.jawHitDone} to true
                                send "&4&lЧелюсти сомкнулись на тебе!" to {_s}

# ===========================================================
# Способность 2 — Хакер раш (feather, КД 50 сек)
#
# Замирание на 1,5 сек, затем неуправляемый рывок вперёд (направление
# фиксируется в момент старта рывка, не стойки) на ~10 блоков. Промах —
# откат идёт полные 50 сек. Попадание по выжившему БЕЗ стака — стак
# ставится, откат ускоряется до 2 сек. Попадание по выжившему СО стаком —
# 3 сердца урона, стак снимается, откат становится обычным (50 сек), сам
# Проект получает замедление 3 на 4 сек. У разных выживших стак считается
# отдельно — рывки можно "стакать", проходясь по разным целям подряд.
# ===========================================================
function projectRushOnHit(p: player, s: player):
    if {project.dashStack.%{_s}%} is true:
        damage {_s} by 3
        set {project.dashStack.%{_s}%} to false
        setCooldownRemaining({_p}, "project_rush", 50)
        send "&4&lСтак пробит! Откат обычный (50 сек)." to {_p}
        projectSlowWalk({_p}, 0.11, 4 seconds)
    else:
        projectSetDashStack({_s})
        setCooldownRemaining({_p}, "project_rush", 2)
        send "&4Рывок зацепил выжившего! Стак поставлен, откат ускорен (2 сек)." to {_p}

function projectPerformRush(p: player):
    set {project.rushHit.%{_p}%} to false
    push {_p} in direction of {_p} at speed 2.6
    loop 10 times:
        wait 1 tick
        if {char.%{_p}%} is not "project":
            stop loop
        if {project.rushHit.%{_p}%} is true:
            stop loop
        loop all players:
            set {_s} to loop-player
            if {_s} is not {_p}:
                if isManiac({char.%{_s}%}) is false:
                    if {alive.%{_s}%} is true:
                        if distance between {_p} and {_s} <= {@projectRushHitRadius}:
                            set {project.rushHit.%{_p}%} to true
                            projectRushOnHit({_p}, {_s})
        if {project.rushHit.%{_p}%} is not true:
            set {_dm} to dummyNearest(location of {_p}, "survivor", {@projectRushHitRadius})
            if {_dm} is set:
                set {project.rushHit.%{_p}%} to true
                dummyRushOnHit({_p}, {_dm})

on right click holding feather:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&4Хакер раш":
        if {char.%player%} is "project":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if tryCooldown(player, "project_rush", 50) is false:
                stop
            set {project.channeling.%player%} to true
            send "&eПодготовка рывка..." to player
            projectSlowWalk(player, 0, 1.5 seconds)
            if {project.channeling.%player%} is true:
                delete {project.channeling.%player%}
                send "&4&lХакер раш!" to player
                projectPerformRush(player)
            else:
                send "&cРывок сорван оглушением!" to player

# ===========================================================
# Способность 3 — Телепорт к заражённому генератору (recovery compass, КД 80 сек)
#
# По ПКМ сразу открывается GUI с текущими заражёнными генераторами (если
# заражённых нет — способность недоступна). Выход из GUI без выбора —
# способность НЕ использована и не расходуется. Клик по иконке — старт
# 4-секундного каста (полная остановка + ошеломление), кулдаун начинает
# идти именно с этого момента. Если во время каста Проект оглушён —
# телепорт отменяется, но 80 сек кулдауна всё равно тратятся (см.
# правку stunPlayer выше — {project.channeling} сбрасывается извне).
# После успешного телепорта: 3 сек неуязвимость к станам + 3 сек
# ошеломление (свои способности недоступны), и стак рывка ставится СРАЗУ
# ВСЕМ живым выжившим.
# ===========================================================
function projectPerformTeleport(p: player, target: location):
    set {project.channeling.%{_p}%} to true
    set {staggered.%{_p}%} to true
    send "&eТелепорт заряжается... не дай себя оглушить!" to {_p}
    projectSlowWalk({_p}, 0, 4 seconds)
    delete {staggered.%{_p}%}
    if {project.channeling.%{_p}%} is true:
        delete {project.channeling.%{_p}%}
        set {_dest} to location((x-coord of {_target}) + 0.5, (y-coord of {_target}) + 1, (z-coord of {_target}) + 0.5, {_target}'s world)
        teleport {_p} to {_dest}
        send "&4&lТелепорт выполнен!" to {_p}
        set {project.stunImmune.%{_p}%} to true
        set {staggered.%{_p}%} to true
        send "&eНеуязвим к станам на 3 сек — способности пока недоступны." to {_p}
        wait 3 seconds
        delete {project.stunImmune.%{_p}%}
        delete {staggered.%{_p}%}
        send "&a✔ Эффекты телепорта закончились." to {_p}
        loop all players:
            set {_s} to loop-player
            if isManiac({char.%{_s}%}) is false:
                if {alive.%{_s}%} is true:
                    projectSetDashStack({_s})
    else:
        send "&cТелепорт сорван оглушением!" to {_p}

on right click holding recovery compass:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if name of player's tool is "&4Телепорт к генератору":
        if {char.%player%} is "project":
            cancel event
            if {stunned.%player%} is true:
                send "&cТы оглушён и не можешь использовать способности!" to player
                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if size of {project.infectedGens::*} is 0:
                send "&7Нет заражённых генераторов для телепорта." to player
                stop
            set {_ready} to true
            if getCooldownRemaining(player, "project_teleport") > 0:
                set {_ready} to false
            if {_ready} is false:
                send "&cЕщё не восстановилось, подожди немного." to player
                stop
            set {_inv} to a new chest inventory with 1 row named "&4Заражённые генераторы"
            set {_slot} to 0
            delete {project.teleLocs.%player%::*}
            loop {project.infectedGens::*}:
                set {_loc} to loop-value
                set {_prog} to 0
                if {gen.progress.%{_loc}%} is set:
                    set {_prog} to {gen.progress.%{_loc}%}
                set {_n} to {_slot} + 1
                set {_it} to anvil named "&4Генератор №%{_n}% (%{_prog}%%%)"
                set slot {_slot} of {_inv} to {_it}
                # --- ФИКС: локацию ищем по ИМЕНИ предмета. Раньше ключ строился из
                #     %clicked slot% (объект слота, а не число), не совпадал с ключом
                #     записи, локация не находилась — и телепорт молча не срабатывал. ---
                set {project.teleLocs.%player%::%name of {_it}%} to {_loc}
                add 1 to {_slot}
            set {project.teleGUI.%player%} to true
            open {_inv} to player

on inventory click:
    if {project.teleGUI.%player%} is true:
        cancel event
        if event-item is anvil:
            set {_loc} to {project.teleLocs.%player%::%name of event-item%}
            close player's inventory
            delete {project.teleGUI.%player%}
            if {_loc} is set:
                if tryCooldown(player, "project_teleport", 80) is true:
                    projectPerformTeleport(player, {_loc})

# --- Выход из меню без выбора сбрасывает флаг (способность не тратится) ---
on inventory close:
    if {project.teleGUI.%player%} is true:
        delete {project.teleGUI.%player%}
# ===========================================================
# ЧЕКЛИСТ: что нужно сделать, чтобы добавить нового персонажа
# (на основе того, как уже подключены denden/necromancer/anomaly/project и т.д.)
# ===========================================================
# 1. characters.sk
#    - getCharDisplayName(charid) — добавить ветку с именем персонажа
#    - give_<charid>_kit(p) функция — стартовый инвентарь/оружие
#    - если это убийца — добавить его в GUI выбора маньяка (choose.role),
#      слот в чест-инвентаре и char.maniacPref
#    - round-reset блок (переменные вида {<charid>.*}, если способность
#      их использует) — обнулять в начале раунда
#
# 2. abilities.sk (этот файл)
#    - функция(и) вида projectPerform...() с логикой способности(ей)
#    - "on right click holding <item>" / другой триггер активации,
#      с проверками {char.%player%}, {stunned.%...%}, {staggered.%...%}
#    - кулдауны через tryCooldown(...)
#
# 3. skins.sk
#    - getCharIcon(charid) — иконка (item type) персонажа для GUI
#    - строка в openSkinCharSelect(...) (слот + иконка + имя)
#    - строка в charidForSlot(slot) — обратное сопоставление слот → charid
#    - если есть кастомный скин через SkinsRestorer — добавить
#      применение/сброс скина на старте/конце раунда
#
# 4. levels.sk
#    - строка в GUI "Твои уровни" (слот, иконка, имя, getCharLevel(player, charid))
#    - функция начисления XP уже общая (awardXP), но нужно убедиться,
#      что вызовы awardXP(..., "<charid>", ...) добавлены в нужных местах
#      (round.sk / generators.sk / abilities.sk)
#
# 5. round.sk
#    - isManiac(charid) — если новый персонаж это убийца, вернуть true
#    - блок выдачи кита в начале раунда (if {char.%{_p}%} is "<charid>": give_..._kit(...))
#    - если у персонажа есть пассивка/эффект на старте раунда (как jump boost
#      у denden) — добавить ветку в блок назначения маньяка
#    - при желании: спец-взаимодействия маньяк↔выживший (see "denden" + "mihuilong"
#      пример с "King of TNT") — не обязательно, только для флейвора
#
# 6. debug.sk
#    - ветка в admin-команде выдачи кита для соло-тестов (give_<charid>_kit)
#
# 7. lockers.sk / lobbyitems.sk / setup.sk
#    - проверить, нет ли там общих списков персонажей/иконок, которые тоже
#      нужно расширить (на момент проверки прямых упоминаний конкретных
#      charid в этих трёх файлах не найдено — но стоит перепроверить вручную,
#      если персонаж должен быть виден в лобби/шкафчиках)
#
# 8. event.sk
#    - если персонаж должен участвовать в ивентах (Battle Royale/LMS) —
#      проверить, не завязана ли логика ивента на конкретный список charid
#
# Итого минимальный набор для "просто нового персонажа без уникальных фич":
# characters.sk (имя+кит) → skins.sk (иконка+скин) → levels.sk (строка в GUI)
# → round.sk (выдача кита, isManiac при необходимости) → debug.sk (тест-кит).
# abilities.sk нужен только если у персонажа есть активная способность.


# =========================================================
# САМУРАИ — подростки-копии клана, убийца с телом-помощником.
# Предметы: бумага (Метка), железный топор (Разрезание),
# эндер-жемчуг (Переключение). Каменный меч — обычный М1.
# =========================================================

function samuraiSpawnBlessed(p: player):
    # Удаляем старое тело этого владельца, если оно осталось после теста.
    loop {samurai.blessed::*}:
        if {samurai.blessedOwner.%loop-value%} is {_p}:
            kill loop-value
            remove loop-value from {samurai.blessed::*}
    spawn a zombie at location of {_p}
    set {_z} to last spawned entity
    set name of {_z} to "&dБлаженный"
    set {samurai.blessedOwner.%{_z}%} to {_p}
    add {_z} to {samurai.blessed::*}
    send "&dБлаженный появился рядом с тобой." to {_p}

function samuraiCanUse(p: player) :: boolean:
    if {stunned.%{_p}%} is true:
        send "&cТы оглушён и не можешь использовать способности!" to {_p}
        return false
    if {staggered.%{_p}%} is true:
        send "&eТы ошеломлён и не можешь использовать способности!" to {_p}
        return false
    if {samurai.grabbing.%{_p}%} is true:
        send "&cВо время Разрезания нельзя использовать способности." to {_p}
        return false
    if {samurai.grabbed.%{_p}%} is true:
        send "&cТы не можешь действовать во время захвата." to {_p}
        return false
    if {samurai.switching.%{_p}%} is true:
        send "&cПереключение ещё не завершено." to {_p}
        return false
    return true

# Во время захвата и обмена позициями игроки не могут перемещаться.
on player move:
    if {samurai.grabbing.%player%} is true:
        cancel event
    if {samurai.grabbed.%player%} is true:
        cancel event
    if {samurai.switching.%player%} is true:
        cancel event

# Блокируем использование любых предметов участниками захвата/переключения.
on right click:
    if {samurai.grabbing.%player%} is true:
        cancel event
    if {samurai.grabbed.%player%} is true:
        cancel event
    if {samurai.switching.%player%} is true:
        cancel event

# Метка: выбранный игрок подсвечивается 15 сек; урон Самураев по нему +0,5.
on right click holding paper:
    if name of player's tool is "&cМетка":
        if {char.%player%} is "samurai":
            cancel event
            if {round.active} is true:
                if {round.live} is not true:
                    stop
            if samuraiCanUse(player) is false:
                stop
            set {_target} to player's target entity
            if {_target} is not a player:
                send "&7Наведи прицел на выжившего, чтобы поставить Метку." to player
                stop
            if isManiac({char.%{_target}%}) is true:
                send "&7Метка ставится только на живого выжившего." to player
                stop
            if {alive.%{_target}%} is not true:
                send "&7Метка ставится только на живого выжившего." to player
                stop
            if tryCooldown(player, "samurai_mark", 30) is true:
                set {samurai.marked.%player%} to {_target}
                set {_markToken} to now
                set {samurai.markToken.%player%} to {_markToken}
                apply glowing to {_target} for 15 seconds
                send "&cМетка поставлена на %{_target}% на 15 секунд." to player
                send "&cСамураи пометили тебя! Получаемый от них урон повышен." to {_target}
                awardXP(player, "samurai", 20)
                wait 15 seconds
                if {samurai.markToken.%player%} is {_markToken}:
                    delete {samurai.marked.%player%}
                    delete {samurai.markToken.%player%}

# Разрезание: ближайший выживший в пределах 3 блоков обездвиживается вместе с убийцей.
on right click holding iron axe:
    if name of player's tool is "&4Разрезание":
        if {char.%player%} is "samurai":
            cancel event
            if {round.active} is true:
                if {round.live} is not true:
                    stop
            if samuraiCanUse(player) is false:
                stop
            delete {_target}
            set {_best} to 3.01
            loop all players:
                if loop-player is not player:
                    if isManiac({char.%loop-player%}) is false:
                        if {alive.%loop-player%} is true:
                            if {stunned.%loop-player%} is not true:
                                if {staggered.%loop-player%} is not true:
                                    set {_d} to distance between player and loop-player
                                    if {_d} <= 3:
                                        if {_d} < {_best}:
                                            set {_best} to {_d}
                                            set {_target} to loop-player
            if {_target} is not set:
                if tryCooldown(player, "samurai_slash", 30) is true:
                    send "&7Рядом нет выжившего для захвата (радиус 3 блока)." to player
                stop
            if tryCooldown(player, "samurai_slash", 30) is true:
                set {_token} to now
                set {samurai.grabbing.%player%} to true
                set {samurai.grabbed.%{_target}%} to true
                set {stunned.%player%} to true
                set {staggered.%player%} to true
                set {stunned.%{_target}%} to true
                set {staggered.%{_target}%} to true
                set {samurai.grabTarget.%player%} to {_target}
                set {samurai.grabToken.%player%} to {_token}
                send "&4Ты схватил %{_target}%! Удерживай его 6 секунд." to player
                send "&cСамураи схватили тебя! Ты обездвижен на 6 секунд." to {_target}
                wait 6 seconds
                if {samurai.grabToken.%player%} is {_token}:
                    if {samurai.grabbing.%player%} is true:
                        if {_target} is online:
                            if {alive.%{_target}%} is true:
                                delete {samurai.grabbing.%player%}
                                delete {samurai.grabbed.%{_target}%}
                                delete {stunned.%player%}
                                delete {staggered.%player%}
                                delete {stunned.%{_target}%}
                                delete {staggered.%{_target}%}
                                delete {samurai.grabTarget.%player%}
                                delete {samurai.grabToken.%player%}
                                set {_kickDamage} to 4
                                if {samurai.marked.%player%} is {_target}:
                                    add 0.5 to {_kickDamage}
                                damage {_target} by {_kickDamage}
                                push {_target} away from player with speed 1
                                send "&4Разрезание завершено: цель получила 4 урона." to player
                                awardXP(player, "samurai", 35)
                            else:
                                delete {samurai.grabbing.%player%}
                                delete {samurai.grabbed.%{_target}%}
                                delete {stunned.%player%}
                                delete {staggered.%player%}
                                delete {stunned.%{_target}%}
                                delete {staggered.%{_target}%}
                                delete {samurai.grabTarget.%player%}
                                delete {samurai.grabToken.%player%}
                        else:
                            delete {samurai.grabbing.%player%}
                            delete {samurai.grabbed.%{_target}%}
                            delete {stunned.%player%}
                            delete {staggered.%player%}
                            delete {stunned.%{_target}%}
                            delete {staggered.%{_target}%}
                            delete {samurai.grabTarget.%player%}
                            delete {samurai.grabToken.%player%}

# Переключение: 3 секунды неподвижности, затем обмен позициями с Блаженным.
# После обмена — 6 секунд иммунитета к оглушению. КД принят равным 30 секундам.
on right click holding ender pearl:
    if name of player's tool is "&5Переключение":
        if {char.%player%} is "samurai":
            cancel event
            if {round.active} is true:
                if {round.live} is not true:
                    stop
            if samuraiCanUse(player) is false:
                stop
            delete {_blessed}
            loop {samurai.blessed::*}:
                if {samurai.blessedOwner.%loop-value%} is player:
                    if loop-value is alive:
                        set {_blessed} to loop-value
            if {_blessed} is not set:
                send "&cБлаженный недоступен — переключение невозможно." to player
                stop
            if tryCooldown(player, "samurai_switch", 30) is true:
                set {_token} to now
                set {samurai.switching.%player%} to true
                set {samurai.switchToken.%player%} to {_token}
                set {_playerLoc} to location of player
                set {_blessedLoc} to location of {_blessed}
                apply slowness 255 to player for 3 seconds
                apply slowness 255 to {_blessed} for 3 seconds
                send "&5Начинается переключение..." to player
                wait 3 seconds
                if {samurai.switchToken.%player%} is {_token}:
                    if {samurai.switching.%player%} is true:
                        if {_blessed} is alive:
                            teleport player to {_blessedLoc}
                            teleport {_blessed} to {_playerLoc}
                            delete {samurai.switching.%player%}
                            delete {samurai.switchToken.%player%}
                            set {samurai.stunImmune.%player%} to true
                            send "&5Позиции обменены. Иммунитет к оглушению: 6 секунд." to player
                            awardXP(player, "samurai", 20)
                            wait 6 seconds
                            delete {samurai.stunImmune.%player%}
                        else:
                            delete {samurai.switching.%player%}
                            delete {samurai.switchToken.%player%}

# Блаженный автономно выбирает ближайшего живого выжившего и атакует его.
every 1 second:
    if {round.active} is true:
        if {round.live} is true:
            loop {samurai.blessed::*}:
                set {_z} to loop-value
                if {_z} is not alive:
                    remove {_z} from {samurai.blessed::*}
                    delete {samurai.blessedOwner.%{_z}%}
                    delete {samurai.blessedStunnedUntil.%{_z}%}
                else:
                    set {_owner} to {samurai.blessedOwner.%{_z}%}
                    if {_owner} is online:
                        if {samurai.blessedStunnedUntil.%{_z}%} is set:
                            if {samurai.blessedStunnedUntil.%{_z}%} > now:
                                set target of {_z} to {_owner}
                            else:
                                delete {samurai.blessedStunnedUntil.%{_z}%}
                        else:
                            set {_closest} to 9999
                            delete {_target}
                            loop all players:
                                if loop-player is not {_owner}:
                                    if isManiac({char.%loop-player%}) is false:
                                        if {alive.%loop-player%} is true:
                                            set {_d} to distance between {_z} and loop-player
                                            if {_d} < {_closest}:
                                                set {_closest} to {_d}
                                                set {_target} to loop-player
                            if {_target} is set:
                                set target of {_z} to {_target}
                            else:
                                set target of {_z} to {_owner}

# Блаженный бессмертен, но удар живого выжившего временно оглушает его на 3 секунды.
on damage:
    if victim is a zombie:
        if {samurai.blessedOwner.%victim%} is set:
            cancel event
            if {round.active} is true:
                if {round.live} is not true:
                    stop
            if attacker is a player:
                if isManiac({char.%attacker%}) is false:
                    set {samurai.blessedStunnedUntil.%victim%} to now + 3 seconds
                    set target of victim to {samurai.blessedOwner.%victim%}
                    apply slowness 255 to victim for 3 seconds
                    send "&eБлаженный оглушён на 3 секунды!" to attacker

# Блаженный не должен переключать агрессию на другого убийцу.
on entity target:
    if {samurai.blessedOwner.%event-entity%} is set:
        if target is a player:
            if isManiac({char.%target%}) is true:
                cancel event

# Метка усиливает весь урон Самураев по помеченной цели, включая удары Блаженного.
on damage:
    if victim is a player:
        if attacker is a player:
            if {char.%attacker%} is "samurai":
                if {samurai.marked.%attacker%} is victim:
                    increase damage by 0.5
        else if attacker is a zombie:
            set {_owner} to {samurai.blessedOwner.%attacker%}
            if {_owner} is set:
                if {samurai.marked.%{_owner}%} is victim:
                    increase damage by 0.5

# Смерть/выход любой стороны немедленно прерывает захват.
on death of a player:
    if {samurai.grabbed.%victim%} is true:
        delete {_owner}
        loop all players:
            if {samurai.grabTarget.%loop-player%} is victim:
                set {_owner} to loop-player
        if {_owner} is set:
            delete {samurai.grabbing.%{_owner}%}
            delete {stunned.%{_owner}%}
            delete {staggered.%{_owner}%}
            delete {samurai.grabTarget.%{_owner}%}
            delete {samurai.grabToken.%{_owner}%}
        delete {samurai.grabbed.%victim%}
        delete {stunned.%victim%}
        delete {staggered.%victim%}
    if {samurai.grabbing.%victim%} is true:
        set {_target} to {samurai.grabTarget.%victim%}
        delete {samurai.grabbed.%{_target}%}
        delete {stunned.%{_target}%}
        delete {staggered.%{_target}%}
        delete {samurai.grabbing.%victim%}
        delete {samurai.grabTarget.%victim%}
        delete {samurai.grabToken.%victim%}

on quit:
    if {samurai.grabbed.%player%} is true:
        loop all players:
            if {samurai.grabTarget.%loop-player%} is player:
                delete {samurai.grabbing.%loop-player%}
                delete {stunned.%loop-player%}
                delete {staggered.%loop-player%}
                delete {samurai.grabTarget.%loop-player%}
                delete {samurai.grabToken.%loop-player%}
        delete {samurai.grabbed.%player%}
        delete {stunned.%player%}
        delete {staggered.%player%}
    if {samurai.grabbing.%player%} is true:
        set {_target} to {samurai.grabTarget.%player%}
        delete {samurai.grabbed.%{_target}%}
        delete {stunned.%{_target}%}
        delete {staggered.%{_target}%}
        delete {samurai.grabbing.%player%}
        delete {samurai.grabTarget.%player%}
        delete {samurai.grabToken.%player%}
