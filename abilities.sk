                            apply glowing to loop-player for 5 seconds
                loop {dummy.list::*}:
                    if {dummy.kind.%loop-value%} is "survivor":
                        if distance between player and loop-value <= 10:
                            apply glowing to loop-value for 5 seconds
                awardXP(player, "necromancer", 10)
                wait 2 seconds
                delete {blocking.%player%}
                wait 33 seconds
                send "&a✔ Дыхание снова готово!" to player

