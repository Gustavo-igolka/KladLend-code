# =========================================================
# parkour/generator.sk — детерминированная генерация трасс
# ID 000–999. Первые три платформы кодируют три цифры ID,
# остальные строятся из детерминированной последовательности.
# =========================================================

function parkourGenerate(p: player, parkourId: text, slot: number):
    set {_id} to "%uuid of {_p}%"
    set {_floorY} to {parkour.base.y} + (({_slot} - 1) * 25)
    set {_world} to {parkour.base.world}
    set {_baseX} to {parkour.base.x}
    set {_baseZ} to {parkour.base.z}

    set {parkour.active::%{_id}%} to true
    set {parkour.id::%{_id}%} to {_parkourId}
    set {parkour.slot::%{_id}%} to {_slot}
    set {parkour.floorY::%{_id}%} to {_floorY}
    set {parkour.return::%{_id}%} to location of {_p}
    set {parkour.gamemode::%{_id}%} to gamemode of {_p}
    add {_id} to {parkour.sessions::*}

    # Стены одного этажа. Все поставленные блоки записываются
    # в список конкретной сессии и удаляются при её завершении.
    loop 23 times:
        set {_yy} to {_floorY} + loop-number
        loop integers from -15 to 15:
            set {_offset} to loop-value

            set {_loc} to location at ({_baseX} - 15), {_yy}, ({_baseZ} + {_offset}) in {_world}
            set block at {_loc} to glass
            add {_loc} to {parkour.blocks.%{_id}%::*}

            set {_loc} to location at ({_baseX} + 15), {_yy}, ({_baseZ} + {_offset}) in {_world}
            set block at {_loc} to glass
            add {_loc} to {parkour.blocks.%{_id}%::*}

            set {_loc} to location at ({_baseX} + {_offset}), {_yy}, ({_baseZ} - 15) in {_world}
            set block at {_loc} to glass
            add {_loc} to {parkour.blocks.%{_id}%::*}

            set {_loc} to location at ({_baseX} + {_offset}), {_yy}, ({_baseZ} + 15) in {_world}
            set block at {_loc} to glass
            add {_loc} to {parkour.blocks.%{_id}%::*}

    # Маршрут из 40 платформ. Соседние платформы разделены
    # коротким промежутком; высота меняется максимум на один блок.
    set {_xs::*} to -12, -8, -4, 0, 4, 8, 12, 12, 12, 12, 12, 12, 12, 8, 4, 0, -4, -8, -12, -12, -12, -12, -12, -12, -8, -4, 0, 4, 8, 8, 8, 8, 4, 0, -4, -4, 0, 4 and 0
    set {_zs::*} to -12, -12, -12, -12, -12, -12, -12, -8, -4, 0, 4, 8, 12, 12, 12, 12, 12, 12, 12, 8, 4, 0, -4, -8, -8, -8, -8, -8, -8, -4, 0, 4, 4, 4, 4, 0, 0, 0, -4 and -4

    set {_seed} to {_parkourId} parsed as number
    set {_hundreds} to floor({_seed} / 100)
    set {_tens} to floor({_seed} / 10) - ({_hundreds} * 10)
    set {_ones} to {_seed} - (floor({_seed} / 10) * 10)
    set {_height} to 0

    loop 40 times:
        set {_step} to loop-number

        # Первые три платформы гарантированно различают все 1000 ID.
        if {_step} is 1:
            set {_variant} to {_hundreds}
        else if {_step} is 2:
            set {_variant} to {_tens}
        else if {_step} is 3:
            set {_variant} to {_ones}
        else:
            set {_seed} to ({_seed} * 7) + 3
            set {_seed} to {_seed} - (floor({_seed} / 1000) * 1000)
            set {_variant} to {_seed} - (floor({_seed} / 10) * 10)

        set {_change} to {_variant} - (floor({_variant} / 3) * 3)
        if {_change} is 0:
            if {_height} > 0:
                subtract 1 from {_height}
        else if {_change} is 2:
            if {_height} < 4:
                add 1 to {_height}

        set {_px} to {_baseX} + {_xs::%{_step}%}
        set {_pz} to {_baseZ} + {_zs::%{_step}%}
        set {_platformY} to {_floorY} + 1 + {_height}

        set {_dx::*} to 0, 1, 0, 1
        set {_dz::*} to 0, 0, 1, 1
        loop 4 times:
            set {_blockX} to {_px} + {_dx::%loop-number%}
            set {_blockZ} to {_pz} + {_dz::%loop-number%}
            set {_loc} to location at {_blockX}, {_platformY}, {_blockZ} in {_world}

            if {_step} is 40:
                set block at {_loc} to emerald block
            else if {_variant} is 0:
                set block at {_loc} to stone bricks
            else if {_variant} is 1:
                set block at {_loc} to cobblestone
            else if {_variant} is 2:
                set block at {_loc} to mossy stone bricks
            else if {_variant} is 3:
                set block at {_loc} to deepslate bricks
            else if {_variant} is 4:
                set block at {_loc} to quartz block
            else if {_variant} is 5:
                set block at {_loc} to prismarine bricks
            else if {_variant} is 6:
                set block at {_loc} to copper block
            else if {_variant} is 7:
                set block at {_loc} to red nether bricks
            else if {_variant} is 8:
                set block at {_loc} to purpur block
            else:
                set block at {_loc} to amethyst block

            add {_loc} to {parkour.blocks.%{_id}%::*}

        if {_step} is 1:
            set {parkour.start::%{_id}%} to location at ({_px} + 0.5), ({_platformY} + 1), ({_pz} + 0.5) in {_world}
        if {_step} is 40:
            set {parkour.finish::%{_id}%} to location at ({_px} + 0.5), ({_platformY} + 1), ({_pz} + 0.5) in {_world}

    set gamemode of {_p} to adventure
    teleport {_p} to {parkour.start::%{_id}%}
    send "&aТрасса &e%{_parkourId}% &aсгенерирована. Доберись до изумрудной платформы." to {_p}
