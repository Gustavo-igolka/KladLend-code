                            kill {sanya.dispenser.%player%}
                            delete {sanya.dispenser.%player%}
                        spawn an armor stand at {_loc}
                        set {_stand} to last spawned entity
                        
                        set {_h} to leather helmet
                        dye {_h} green
                        set helmet of {_stand} to {_h}
                        
                        set {_c} to leather chestplate
                        dye {_c} green
                        set chestplate of {_stand} to {_c}
                        
                        set {_l} to leather leggings
                        dye {_l} green
                        set leggings of {_stand} to {_l}
                        
                        set {_b} to leather boots
                        dye {_b} green
                        set boots of {_stand} to {_b}

                        set {sanyaOwner.%{_stand}%} to player
                        set {sanyaType.%{_stand}%} to "dispenser"
                        set {sanya.dispenser.%player%} to {_stand}
                        send "&a✔ Раздатчик установлен!" to player
                        awardXP(player, "sanya", 20)
                        sanyaDispenserAura(player, {_stand})
                wait 34 seconds
                send "&a✔ Раздатчик снова готов к установке!" to player

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if victim is an armor stand:
        if {sanyaOwner.%victim%} is set:
            if attacker is a player:
                set {_sanyaAllowed} to false
                if isManiac({char.%attacker%}) is true:
                    set {_sanyaAllowed} to true
                else if {event.misha.br_active} is true:
                    set {_sanyaAllowed} to true
                if {_sanyaAllowed} is true:
                    set {_owner} to {sanyaOwner.%victim%}
                    set {_type} to {sanyaType.%victim%}
                    if {_type} is "turret":
                        if {sanya.turret.%{_owner}%} is victim:
                            delete {sanya.turret.%{_owner}%}
                        send "&cВаша турель уничтожена!" to {_owner}
                    else if {_type} is "dispenser":
                        if {sanya.dispenser.%{_owner}%} is victim:
                            delete {sanya.dispenser.%{_owner}%}
                        send "&cВаш раздатчик уничтожен!" to {_owner}
                    delete {sanyaOwner.%victim%}
                    delete {sanyaType.%victim%}
                    kill victim
                else:
                    cancel event
            else:
                cancel event

on damage:
    if {round.active} is true:
        if {round.live} is not true:
            cancel event
            stop
    if victim is a player:
        if {char.%victim%} is "sanya":
            if {round.active} is true:
                if event isn't cancelled:
                    apply resistance 2 to victim for 6 seconds

# --- Стойки Сани (турель/раздатчик): нельзя снимать с них броню правым кликом.
#     Стойки без {sanyaOwner} (например, манекены) не затрагиваются. ---
on right click on armor stand:
    if {sanyaOwner.%clicked entity%} is set:
        cancel event
# ---------------------------------------------------------

# ДЕТЕКТИВ — поддержка / контроль через исследование и голема
# =========================================================

# Подзорная труба используется только как кнопка способности.
on right click holding spyglass:
    if name of player's tool is "&bИсследование":
        cancel event
        if {char.%player%} is not "detective":
            stop
        if {round.active} is true:
            if {round.live} is not true:
                stop
            if {alive.%player%} is not true:
                stop
        if {stunned.%player%} is true:
            send "&cТы оглушён и не можешь использовать способности!" to player
            stop
        if {staggered.%player%} is true:
            send "&eТы ошеломлён и не можешь использовать способности!" to player
            stop
        if tryCooldown(player, "detective_research", 45) is true:
            # Один общий источник не позволяет нескольким срабатываниям этого баффа складываться.
            set {_source} to "detective_research"
            set {_affected} to 0
            delete {_affectedPlayers::*}
            loop all players:
                set {_target} to loop-player
                # Детектив не усиливает себя; убийца исключается и по роли, и по round.maniac.
                if {_target} is not player:
                    if {_target} is not {round.maniac}:
                        if {char.%{_target}%} is set:
                            if isManiac({char.%{_target}%}) is false:
                                if {alive.%{_target}%} is true:
                                    if distance between player and {_target} <= 5:
                                        add 1 to {_affected}
                                        add {_target} to {_affectedPlayers::*}
                                        if {detective.research.%player%} < 12:
                                            add 1 to {detective.research.%player%}
                                        setCooldownModifier({_target}, {_source}, "all_except_detective", 1.5, 5)
                                        send "&bДетектив ускорил восстановление твоих способностей на 5 секунд." to {_target}
            send "&bИсследование завершено. Задето выживших: %{_affected}%. Очки исследования: %{detective.research.%player%}%/12." to player
            awardXP(player, "detective", 20)
            # Снимаем именно источник Детектива, не затрагивая другие модификаторы перезарядки.
            wait 5 seconds
            loop {_affectedPlayers::*}:
                set {_target} to loop-value
                # Если другой Детектив обновил общий бафф, не снимаем его раньше срока.
                if {cd.modifier.until.%{_target}%.%{_source}%.all_except_detective} is set:
                    if {cd.modifier.until.%{_target}%.%{_source}%.all_except_detective} <= now:
                        delete {cd.modifier.until.%{_target}%.%{_source}%.all_except_detective}
                        delete {cd.modifier.rate.%{_target}%.%{_source}%.all_except_detective}
                        remove "all_except_detective" from {cd.modifierKeys.%{_target}%.%{_source}%::*}
                        remove {_source} from {cd.modifierSources.%{_target}%::*}
                        delete {cd.modifierKeys.%{_target}%.%{_source}%::*}

# Железный слиток призывает единственного активного голема.
on right click holding iron ingot:
    if name of player's tool is "&7Призыв голема":
        cancel event
        if {char.%player%} is not "detective":
            stop
        if {round.active} is true:
            if {round.live} is not true:
                stop
            if {alive.%player%} is not true:
                stop
        if {stunned.%player%} is true:
            send "&cТы оглушён и не можешь использовать способности!" to player
            stop
        if {staggered.%player%} is true:
            send "&eТы ошеломлён и не можешь использовать способности!" to player
            stop
        if {detective.research.%player%} < 3:
            send "&cНужно минимум 3 очка исследования для призыва голема." to player
            stop
        if {detective.activeGolem} is set:
            if {detective.activeGolem} is alive:
                send "&cГолем уже существует. Дождись его исчезновения." to player
                stop
            delete {detective.activeGolem}
        if tryCooldown(player, "detective_golem", 60) is true:
            set {_research} to {detective.research.%player%}
            set {_bonusSteps} to floor((({_research} - 3) / 3))
            set {_golemHealth} to 7 + ({_bonusSteps} * 0.5)
            spawn an iron golem at location of player
            set {_golem} to last spawned entity
            set max health of {_golem} to {_golemHealth}
            set health of {_golem} to {_golemHealth}
            set {detective.activeGolem} to {_golem}
            set {detective.golemOwner.%{_golem}%} to player
            set {detective.golemHealth.%{_golem}%} to {_golemHealth}
            set {detective.research.%player%} to 0
            if {round.maniac} is set:
                set target of {_golem} to {round.maniac}
            send "&bГолем призван! Здоровье: %{_golemHealth}% сердца. Очки исследования потрачены." to player
            awardXP(player, "detective", 30)
            wait 30 seconds
            if {detective.activeGolem} is {_golem}:
                if {_golem} is alive:
                    kill {_golem}
                delete {detective.activeGolem}
                delete {detective.golemOwner.%{_golem}%}
                delete {detective.golemHealth.%{_golem}%}
                send "&7Голем исчез." to player

# Голем целится только в убийцу. Его удары отталкивают, но не наносят урон.
on entity target:
    if event-entity is an iron golem:
        if {detective.golemOwner.%event-entity%} is set:
            if {round.maniac} is set:
                set target of event-entity to {round.maniac}

on damage:
    # Удары голема не наносят урон: вместо этого убийца отталкивается.
    if attacker is an iron golem:
        if {detective.golemOwner.%attacker%} is set:
            cancel event
            if victim is a player:
                if isManiac({char.%victim%}) is true:
                    push victim away from attacker with speed 1.2
    # Выжившие не могут случайно уничтожить собственного голема.
    if victim is an iron golem:
        if {detective.golemOwner.%victim%} is set:
            if attacker is a player:
                if isManiac({char.%attacker%}) is false:
                    cancel event

on death of an iron golem:
    if {detective.golemOwner.%victim%} is set:
        clear drops
        if {detective.activeGolem} is victim:
            delete {detective.activeGolem}
        delete {detective.golemOwner.%victim%}
        delete {detective.golemHealth.%victim%}