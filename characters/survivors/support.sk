                stop
            if {staggered.%player%} is true:
                send "&eТы ошеломлён и не можешь использовать способности!" to player
                stop
            if tryCooldown(player, "sanya_dispenser", 40) is true:
                send "&aУстановка раздатчика... (6 сек, не двигайся!)" to player
